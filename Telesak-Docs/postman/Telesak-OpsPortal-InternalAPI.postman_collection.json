    {
      "name": "05 - Cross-check the list against the range endpoint",
      "item": [
        {
          "name": "A task's own list matches what the company range reports for it",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rangeItems = pm.response.json().data.filter(i => i.taskId === Number(pm.collectionVariables.get('taskId')));",
                  "",
                  "// The two endpoints share one projection, so they must not disagree.",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/internal/tasks/' + pm.collectionVariables.get('taskId') + '/attachments',",
                  "  method: 'GET',",
                  "  header: { 'X-Ops-Portal-Key': pm.collectionVariables.get('opsPortalKey') }",
                  "}, (err, res) => {",
                  "  pm.test('per-task list reachable', () => pm.expect(err).to.eql(null));",
                  "  if (err) { return; }",
                  "  const listItems = res.json().data;",
                  "  const rangeIds = rangeItems.map(i => i.attachmentId).sort((a, b) => a - b);",
                  "  const listIds = listItems.map(i => i.attachmentId).sort((a, b) => a - b);",
                  "  pm.test('same attachment ids from both endpoints', () => pm.expect(rangeIds).to.eql(listIds));",
                  "  rangeItems.forEach(r => {",
                  "    const l = listItems.find(i => i.attachmentId === r.attachmentId);",
                  "    if (!l) { return; }",
                  "    pm.test('attachment ' + r.attachmentId + ' - fileExists agrees', () => pm.expect(r.fileExists).to.eql(l.fileExists));",
                  "    pm.test('attachment ' + r.attachmentId + ' - sizeBytes agrees', () => pm.expect(r.sizeBytes).to.eql(l.sizeBytes));",
                  "    pm.test('attachment ' + r.attachmentId + ' - uploadedAtUtc agrees', () => pm.expect(r.uploadedAtUtc).to.eql(l.uploadedAtUtc));",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Ops-Portal-Key", "value": "{{opsPortalKey}}" }
            ],
            "url": "{{baseUrl}}/api/internal/companies/{{companyId}}/attachments?pageSize=500"
          }
        }
      ]
    }
  ]
