              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const first = JSON.parse(pm.collectionVariables.get('pageOneIds') || '[]');",
                  "const second = body.data.map(i => i.attachmentId);",
                  "const overlap = second.filter(id => first.indexOf(id) !== -1);",
                  "pm.test('no attachmentId appears on both pages', () => pm.expect(overlap).to.eql([]));",
                  "if (first.length && second.length) {",
                  "  pm.test('page 2 continues after page 1', () => pm.expect(Math.min.apply(null, second)).to.be.above(Math.max.apply(null, first)));",
                  "}"
                ]
              }
            }
