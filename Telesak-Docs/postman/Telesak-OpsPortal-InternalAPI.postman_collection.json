                  "const body = pm.response.json();",
                  "pm.test('at most 2 items', () => pm.expect(body.data.length).to.be.at.most(2));",
                  "pm.collectionVariables.set('pageOneIds', JSON.stringify(body.data.map(i => i.attachmentId)));"
                ]
