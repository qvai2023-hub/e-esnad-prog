              <Style>None</Style>
            </Border>
            <PaddingLeft>5pt</PaddingLeft>
          </Style>
        </Textbox>
        <!-- Report Title (Center) -->
        <Textbox Name="HeaderReportTitle">
          <CanGrow>true</CanGrow>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>تقرير الحضور والانصراف</Value>
                  <Style>
                    <FontFamily>Arial</FontFamily>
                    <FontSize>16pt</FontSize>
                    <FontWeight>Bold</FontWeight>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Center</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Top>1.8cm</Top>
          <Left>0cm</Left>
          <Height>0.7cm</Height>
          <Width>19cm</Width>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
          </Style>
        </Textbox>
        <!-- Date Range in Header -->
        <Textbox Name="HeaderDateRange">
          <CanGrow>true</CanGrow>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>=IIF(IsNothing(Parameters!StartDate.Value) Or IsNothing(Parameters!EndDate.Value) Or Len(CStr(Parameters!StartDate.Value)) = 0 Or Len(CStr(Parameters!EndDate.Value)) = 0, "", "من " &amp; Parameters!StartDate.Value &amp; " إلى " &amp; Parameters!EndDate.Value)</Value>
                  <Style>
                    <FontFamily>Arial</FontFamily>
                    <FontSize>11pt</FontSize>
                    <Color>#555555</Color>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Center</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Top>2.6cm</Top>
          <Left>0cm</Left>
          <Height>0.6cm</Height>
          <Width>19cm</Width>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
          </Style>
        </Textbox>
        <!-- Separator Line -->
        <Line Name="HeaderSeparator">
          <Top>3.5cm</Top>
          <Left>0cm</Left>
          <Height>0cm</Height>
          <Width>19cm</Width>
          <Style>
            <Border>
              <Color>#cccccc</Color>
              <Style>Solid</Style>
              <Width>1pt</Width>
            </Border>
          </Style>
        </Line>
      </ReportItems>
      <Style>
        <Border>
          <Style>None</Style>
        </Border>
      </Style>
    </PageHeader>
    <PageFooter>
      <Height>1.5cm</Height>
      <PrintOnFirstPage>true</PrintOnFirstPage>
      <PrintOnLastPage>true</PrintOnLastPage>
      <ReportItems>
        <Textbox Name="PrintDate">
          <CanGrow>true</CanGrow>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>=Parameters!ReportDateTime.Value</Value>
                  <Style>
                    <FontFamily>Arial</FontFamily>
                    <FontSize>9pt</FontSize>
                  </Style>
                </TextRun>
                <TextRun>
                  <Value> : تاريخ الطباعة</Value>
                  <Style>
                    <FontFamily>Arial</FontFamily>
                    <FontSize>9pt</FontSize>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Right</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Top>0.3cm</Top>
          <Left>13cm</Left>
          <Height>0.5cm</Height>
          <Width>6cm</Width>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
          </Style>
        </Textbox>
        <Textbox Name="PageNumber">
          <CanGrow>true</CanGrow>
          <Paragraphs>
            <Paragraph>
              <TextRuns>
                <TextRun>
                  <Value>="صفحة " &amp; Globals!PageNumber &amp; " من " &amp; Globals!TotalPages</Value>
                  <Style>
                    <FontFamily>Arial</FontFamily>
                    <FontSize>9pt</FontSize>
                  </Style>
                </TextRun>
              </TextRuns>
              <Style>
                <TextAlign>Left</TextAlign>
              </Style>
            </Paragraph>
          </Paragraphs>
          <Top>0.3cm</Top>
          <Left>0cm</Left>
          <Height>0.5cm</Height>
          <Width>4cm</Width>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
          </Style>
        </Textbox>
      </ReportItems>
      <Style>
        <Border>
          <Style>None</Style>
        </Border>
      </Style>
    </PageFooter>
    <PageHeight>29.7cm</PageHeight>
    <PageWidth>21cm</PageWidth>
    <LeftMargin>1cm</LeftMargin>
    <RightMargin>1cm</RightMargin>
    <TopMargin>1cm</TopMargin>
    <BottomMargin>1cm</BottomMargin>
    <Style />
  </Page>
  <ReportParameters>
    <ReportParameter Name="ReportDateTime">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <Prompt>ReportDateTime</Prompt>
    </ReportParameter>
    <ReportParameter Name="LogoUrl">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <Prompt>LogoUrl</Prompt>
    </ReportParameter>
    <ReportParameter Name="StartDate">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>StartDate</Prompt>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>EndDate</Prompt>
    </ReportParameter>
    <ReportParameter Name="ReportPeriod">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>ReportPeriod</Prompt>
    </ReportParameter>
  </ReportParameters>
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
  <rd:ReportID>attendance-report-v2</rd:ReportID>
</Report>
