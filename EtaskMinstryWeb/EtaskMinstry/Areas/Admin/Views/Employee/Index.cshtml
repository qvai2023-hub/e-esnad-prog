@using EtaskMinstry
@using Resources
@using EtaskMinstry.AppCode
@model IEnumerable<EtaskMinstry.Areas.Admin.Models.CompanyEmployeeVM>
@{
    ViewBag.Title = " الموظفين";
}

         <!--Add-->
<div class="panel-heading">

    <div class="pull-right">
        <a id="addPath" href="/Admin/Employee/AddEdit" class="btn btn-xs btn-success">إضافة <i class="fa fa-plus"></i></a>
    </div>
</div>
<!--/Add-->
<!-- Tasks table -->
<div class="panel panel-default">
    <div class="panel-heading">

        <h6 class="panel-title"> @ViewBag.Title</h6>
        <span class="pull-right label label-danger">@ViewBag.count</span>


    </div>
    <!--Search-->
    <div class="panel-body">
        <div class="panel-group">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h6 class="panel-title panel-trigger">
                        <a data-toggle="collapse" href="#panel-search">بحث</a>
                    </h6>
                </div>
                <div id="panel-search" class="panel-collapse collapse">
                    <div class="panel-body">
                        @*<form action="/Admin/Company/Index" method="post" class="form-horizontal">*@
                        @using (Ajax.BeginForm("Search", "Employee", new AjaxOptions
                        {
                            InsertionMode = InsertionMode.Replace,
                            UpdateTargetId = "data",
                            LoadingElementId = "loadding",
                            LoadingElementDuration = 30,
                            OnBegin = ""
                        }, new { area = "Admin", id = "SearchForm" }))
                        {
                            @*@Html.AntiForgeryToken()*@
                            <div class="row">
                                <div class="form-group col-sm-6">
                                    <label class="col-sm-4 control-label">اسم الموظف: </label>
                                    <div class="col-sm-8">
                                        @Html.TextBox("Name", "", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group col-sm-6">

                                    <label class="col-sm-4 control-label">اسم الشركة : </label>
                                    <div class="col-sm-8">
                                        @Html.TextBox("companyName", "", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-6">

                                    <label class="col-sm-4 control-label"> الوظيفة : </label>
                                    <div class="col-sm-8">
                                        @Html.TextBox("JobTitle", "", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-6">

                                    <label class="col-sm-4 control-label">البريد الالكتروني: </label>
                                    <div class="col-sm-8">
                                        @Html.TextBox("Email", "", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-6">

                                    <label class="col-sm-3 control-label">الحالة: </label>
                                    <div class="col-sm-3">
                                        @Html.RadioButton("IsActive", 1)
                                        فعال

                                    </div>
                                    <div class="col-sm-3">
                                        @Html.RadioButton("IsActive", 2)
                                        غير فعال

                                    </div>
                                    <div class="col-sm-3">
                                        @Html.RadioButton("IsActive", 3,true)
                                        الكل

                                    </div>
                                </div>
                            </div>
                            <div class="text-right">
                                <input type="submit" class="btn btn-primary" value="بحث">
                                <input type="button" id="ShowAll" class="btn btn-primary" value="عرض الكل">
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--/Search-->

    <div class="datatable-tasks" id="data">
        @{ Html.RenderPartial("_Index",Model ); }

    </div>
</div>
<script>
          function Search() {
            debugger;
               var mySearchData = { "Name": '', "companyName": '', "JobTitle": '', "Email": '',"IsActive":'3'};
               $.ajax({
                        type: 'Post',
                   url: '@Url.Action("Search")',
                   data: mySearchData,
                        success: function (data) {
                            $("#data").html(data);
                        }
                    });
        }
    $(document).ready(function () {

      $("#ShowAll").click(function () {
            debugger;
            $('.errorMsg').hide();
            $('.errorMsgDate').hide();
            $('#Name').val('');
            $('#companyName').val('');
            $("#JobTitle").val('');
            $("#Email").val('');
         $('.custom-bar .strenth-colors').css('width', '0px');
          var mySearchData = { "Name": '', "companyName": '', "JobTitle": '', "Email": '',"IsActive":'3'};
               $.ajax({
                        type: 'Post',
                   url: '@Url.Action("Search")',
                   data: mySearchData,
                        success: function (data) {
                            $("#data").html(data);
                        }
                    });
        });
    });
    $(function () {

            $(".SetIsactive").live("change", function () {
                var id = $(this).attr("id");

                $.ajax({
                    type: 'Post',
                    url: '@Url.Action("SetIsActive")',
                    dataType: 'json',
                    data: { "EmpID": id }
                });
            });
            //add validation rule to search name
            var re = /^(([^<>()[\]\\.,;:\s@@\"]+(\.[^<>()[\]\\.,;:\s@@\"]+)*)|(\".+\"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;

            $('#strTitle').rules("add", { regex: "@ValidationResource.RevString150" });
            $('#strJobTitleSearch').rules("add", { regex: "@ValidationResource.RevString150" });
            //$('#strEmailSearch').rules("add", { regex: re });
            $('#strEmailSearch').rules("add", { regex: "@ValidationResource.revSearchMail" });




        });
        var ele = "";
        $(".deleteEmp").on("click", function () {
            ele = $(this).closest('tr');

        });

        $(".modal_btn_accept").on("click", function () {
            debugger;
            ele.hide();
            $('.modal').hide();
        });

</script>
<style>
    #list .fav-grid {
        border-collapse: collapse;
        border-spacing: 0;
    }

    .FirstColumn {
        width: 39%;
        text-align: center;
    }

    .SecondColumn {
        width: 19%;
        text-align: center;
    }


    .ThirdColumn {
        width: 16%;
        text-align: center;
    }

    .FourthColumn, .fivethColumn {
        width: 14%;
        text-align: center;
    }

    .table {
        display: table;
        width: 100%;
        margin-top: 10px;
        border-collapse: collapse;
    }

        .table tr td {
            border-bottom: solid 1px #CCC;
            padding: 5px;
        }

    .tblHeader {
        background-repeat: repeat-x;
        font-weight: bold;
        text-align: center;
        height: 25px;
        border: 0;
    }

        .tblHeader th {
            padding-top: 4px;
        }

            .tblHeader th a {
                color: #FFF !important;
                padding-top: 4px;
            }

    .pagerbar {
        text-align: center;
    }

    table thead tr th, table thead tr td, table tfoot tr th, table tfoot tr td {
        text-align: center !important;
    }


</style>

<script>

    applyClassesToWebGrid();

</script>
