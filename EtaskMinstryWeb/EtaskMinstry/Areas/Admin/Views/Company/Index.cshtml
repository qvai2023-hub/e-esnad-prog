@using EtaskMinstry
@using EtaskMinstry.AppCode
@model IEnumerable<EtaskMinstry.Areas.Admin.Models.CompanyVM>
@{
    ViewBag.Title = " الشركات";
}

         <!--Add-->
<div class="panel-heading">

    <div class="pull-right">

        <a id="addPath" href="/Admin/Company/AddEdit" class="btn btn-xs btn-success">إضافة <i class="fa fa-plus"></i></a>

    </div>
</div>
<!--/Add-->
     <!-- Tasks table -->
<div class="panel panel-default">
    <div class="panel-heading">

        <h6 class="panel-title"> @ViewBag.Title</h6>
        <span class="pull-right label label-danger">@ViewBag.count</span>


    </div>
    <!--Search-->
    <div class="panel-body">
        <div class="panel-group">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h6 class="panel-title panel-trigger">
                        <a data-toggle="collapse" href="#panel-search">بحث</a>
                    </h6>
                </div>
                <div id="panel-search" class="panel-collapse collapse">
                    <div class="panel-body">
                        @*<form action="/Admin/Company/Index" method="post" class="form-horizontal">*@
                        @using (Ajax.BeginForm("Search", "Company", new AjaxOptions
                        {
                            InsertionMode = InsertionMode.Replace,
                            UpdateTargetId = "data",
                            LoadingElementId = "loadding",
                            LoadingElementDuration = 30,
                            OnBegin = ""
                        }, new { area = "Admin", id = "SearchForm" }))
                        {
                            <div class="row">
                                <div class="form-group col-sm-6">
                                    <label class="col-sm-4 control-label">اسم الشركة: </label>
                                    <div class="col-sm-8">
                                        @Html.TextBox("Name", "", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group col-sm-6">

                                    <label class="col-sm-4 control-label">السجل التجاري: </label>
                                    <div class="col-sm-8">
                                        @Html.TextBox("CommercialRegister", "", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group col-sm-6">

                                    <label class="col-sm-4 control-label">البريد الالكتروني: </label>
                                    <div class="col-sm-8">
                                        @Html.TextBox("Email", "", new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-6">

                                    <label class="col-sm-4 control-label">الحالة: </label>
                                    <div class="col-sm-2">
                                        @Html.RadioButton("IsActive", 1)
                                        فعال

                                    </div>
                                    <div class="col-sm-4">
                                        @Html.RadioButton("IsActive", 2)
                                        غير فعال

                                    </div>
                                    <div class="col-sm-2">
                                        @Html.RadioButton("IsActive", 3, true)
                                        الكل

                                    </div>
                                </div>
                            </div>

                            <div class="text-right">

                                @*<input type="button" id="Searchbtn" value="بحث" class="btn btn-primary" />
                                    <input name="Submit0" id="btnShowAll" type="button" class="btn btn-primary" value="عرض الكل" />*@
                                <input type="submit" class="btn btn-primary" value="بحث">
                                <input type="button" id="ShowAll" class="btn btn-primary" value="عرض الكل">

                            </div>
                        }
                        @*</form>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--/Search-->
    <div class="datatable-tasks" id="data">
        @{ Html.RenderPartial("_Index", Model); }
    </div>
</div>

<div class="modal" id="passpopup">
    <div class="modal-dialog pop-box">
        <div class="modal-content">
            <div class="modal-header">
                <div class="pop-title">
                    <h4 class="modal_title">كلمة المرور</h4>
                </div>
            </div>
            <div class="modal-body" id="divPass" style="text-align: center;">

            </div>
            <div class="modal-footer">
                <input type="button" id="passpopupClose" class="modal_btn_cancel btn  btn-defaul" value="اغلاق" />

            </div>
        </div>
    </div>
</div>

