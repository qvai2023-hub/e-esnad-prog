@model EtaskMinstry.Areas.Admin.Models.CompanyVM

@{
    ViewBag.Title = " بيانات الشركة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="panel panel-default">
    <div class="panel-heading">
        <h6 class="panel-title">بينات الشركة</h6>
       </div>
    <div class="panel-body">
        <table class="table table-bordered">
            <tr>
                <td class="col-sm-2">@Html.LabelFor(model => model.Name) :</td>
                <td>@Html.DisplayFor(model => model.Name)</td>
            </tr>
            <tr>
                <td class="col-sm-2">@Html.LabelFor(model => model.Address) :</td>
                <td class="col-sm-10">@Html.DisplayFor(model => model.Address)</td>
            </tr>
            <tr>
                <td class="col-sm-2">@Html.LabelFor(model => model.Phone) :</td>
                <td class="col-sm-10">@Html.DisplayFor(model => model.Phone)</td>
            </tr>
            <tr>
                <td class="col-sm-2">@Html.LabelFor(model => model.Email) :</td>
                <td class="col-sm-10">@Html.DisplayFor(model => model.Email)</td>
            </tr>
            <tr>
                <td class="col-sm-2">@Html.LabelFor(model => model.CommercialRegister) :</td>
                <td class="col-sm-10">@Html.DisplayFor(model => model.CommercialRegister)</td>
            </tr>
            <tr>
                <td class="col-sm-2" style="font-weight:bold">الحالة :</td>
                    @if (Model.IsActive == true)
                    { <td class="col-sm-10">فعال</td>}
                    else
                    {<td class="col-sm-10">غير فعال</td>}
             
            </tr>
            <tr>
                <td class="col-sm-2"><b>@Html.LabelFor(model => model.Logo) :</b></td>
                <td class="col-sm-10"><img style="width:80px" src="/Upload/company/@Model.Logo" /></td>
            </tr>
        </table>
        <br />
        <a href="/Admin/Company" class="pull-right btn btn-primary ">الرجوع للقائمة</a>
    
      </div>

