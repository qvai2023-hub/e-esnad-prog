                    timeUnitID :$('#ddlTimeUnit').val()=="" ? null:$('#ddlTimeUnit').val(),
                    projectID:$('#ProjectID').val(),
                    desc : $('#txtDesc').val(),
                } ;
                $.post(url, Taskdata, function (data) {
                    debugger
                    if (data =="DurationError" ) {
                        isValid = false;
                        $('#vldDuration')[0].innerHTML="الوقت المقدر أكبر من الوقت المتاح";
                    }
                    else if(data == "Sucess")
                    {
                        debugger
                        Notify("success", "تم الحفظ بنجاح", 3000);
                        @* window.location.href = "/Company/Company/TaskDetails/@Model.TaskID";*@
                    }
