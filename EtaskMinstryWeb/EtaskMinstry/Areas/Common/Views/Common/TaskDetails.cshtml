<script>

    //for time scroller
    var actualtime ={
        index: 0,
        step: 0,
        TimeCount: 0

    }
    var temp = @Model.TimeDetails.Count();
    actualtime.TimeCount = @Model.TimeDetails.Count();
    debugger;
    //for Scroll right
    actualtime.index = actualtime.TimeCount - 2;

    //check if value even or odd
    function isEven(value) {
        if (value%2 == 0)
            return true;
        else
            return false;
    }
    actualtime.step = temp / 2;
    var bReturn = isEven(temp);
    if (bReturn) {
        if( actualtime.step != 1)
            actualtime.step = actualtime.step - 1;
        else {
            actualtime.step = actualtime.step;
        }

    } else {
        if( actualtime.step != 1)
            actualtime.step = actualtime.step - 0.5;
        else {
            actualtime.step = actualtime.step;
        }

    }
    $('#arrow-right').click(function () {
        if(actualtime.index != actualtime.TimeCount){
            if (actualtime.step >=1) {

                $(".slides li").animate({ left: "+=214" });
                actualtime.step--;
                actualtime.index--;

            }

            else if (actualtime.step == 0) { actualtime.step = 0;}

        }

    });

    //for Scroll left
    $('#arrow-left').click(function () {
        if (actualtime.index == (actualtime.TimeCount - 2))
        {
            actualtime.index = (actualtime.TimeCount - 2);
        }
        else if (actualtime.step >= 0) {
            actualtime.index++;
            actualtime.step++;
            $(".slides li").animate({ left: "-=214" });
        }

    });



    $('.long-text').readmore({
        speed: 75,
        maxHeight: 55
    });
    var approvConfirmation;
    //hold Current Employee ID in case of reassifn
    var CurrentEmp ='@Model.EmpID';
    var PriorityID= '@Model.PriorityID';
    $(function () {
        //Clear "-" incase if Empty Date
        if($("#dtStartDate").val()=="-")
            $("#dtStartDate").val("");
        if($("#dtEndDate").val()=="-")
            $("#dtEndDate").val("");

        $(document).ready(function()
        {
            if('@Model.IsAttach'== "True")
            {
                $('.dactive-tab').click();
            }
        });
        //*************F O R  U I  P R I O R I T Y  C O N T R O L  A N D  H I J R I  C A L E N D E R  ***********//
        // Priority Control .

        $('.strenth-bar').click(function (e)
        {
            if( $(this).attr('canchange')==1)
            {
                var leftPiont = (((e.pageX - $(this).offset().left) - 88) / 88 * -100);
                var obj = $(this).children('.strenth-colors');
                $(this).removeAttr('title');
                var OldWidth = $(this).children('.strenth-colors').width() / 88 * 100;
                //var PriorityID;
                if (parseInt(leftPiont) >= 0 && parseInt(leftPiont) <= 25) {
                    $('#trSubmit').show();
                    $(obj).css('width', '25%');
                    PriorityID=1;
                }
                if (parseInt(leftPiont) >= 25 && parseInt(leftPiont) <= 50) {
                    $('#trSubmit').show();
                    $(obj).css('width', '50%');
                    PriorityID=2;
                }
                if (parseInt(leftPiont) >= 50 && parseInt(leftPiont) <= 75) {
                    $('#trSubmit').show();
                    $(obj).css('width', '75%');
                    PriorityID=3;
                }
                if (parseInt(leftPiont) >= 75 && parseInt(leftPiont) <= 100) {
                    $('#trSubmit').show();
                    $(obj).css('width', '100%');
                    PriorityID=4;
                }
            }
            else
            {
                $(this).css("cursor","auto");
            }
        });


        //show Submit Button
        $('#txtDuration,#ddlTimeUnit,#txtDesc,#ProjectID').on('change',function(){
            $('#trSubmit').show();
        });

        $("#ddlTimeUnit").change(function (evt) {
            debugger
            var val = $(this).val();
            if ($(this).val() == "") {
                $('#txtDuration').attr("disabled", "disabled");
            }
            else {
                $('#txtDuration').removeAttr("disabled");
            }
        });

        $('#dtEndDate,#dtStartDate').click(function()
        {
            $('#trSubmit').show();
        });

        //Check Date Greg OR Hijrii
        var Isgreg ="@(MvcApplication.IsGregDate)";
        if(Isgreg=="True")
        {
            $('#dtEndDate').datepicker($.datepicker.regional[ "ar" ]);
            $('#dtStartDate').datepicker($.datepicker.regional[ "ar" ]);
        }
        else
        {
            $('#dtEndDate,#dtStartDate').calendarsPicker({
                changeMonth: true,
                changeYear: true,
                showTrigger: '#calImg',
                calendar: $.calendars.instance('ummalqura'),
                dateFormat: 'dd/mm/yyyy',
                yearRange: "1400:1500"
            });
        }
        //************** F O R  R E A S S I G N  S C E N A R I O *********************************//
        //Define Reassign Modal
        modal = new Modal({
            title: ' إعاده أسناد المهمة', //title of the popup
            message: '', // message text  notes: overrided if there're  id form
            type: '',  // type of the modal 'alert', 'confirm' or 'form'
            id: 'dialogForm',  // id of the form to show it on the modal
            onAccept: function () {e},// call back runs after modal accept,
            onCancel: function () {e} // call back runs after modal cancel default  is false , closes the modal.
        });

        var GregORHijriiDateNow;
        var Isgreg ="@(MvcApplication.IsGregDate)";
        if(Isgreg=="True")
        {
            GregORHijriiDateNow='@QvLib.QVUtil.Date.GDateNow("dd/MM/yyyy")';
        }
        else
        {
            GregORHijriiDateNow='@QvLib.QVUtil.Date.HDateNow("dd/MM/yyyy")';
        }


        // Handle Reassign Icon CLick
        $('.assign').click(function (e) {
            e.preventDefault();
            debugger;
            if('@Model.StartDate'  =="-"  || '@Model.EndDate' == "-")
            {
                if(CurrentEmp=="0")
                {
                    $("#dialogForm").closest('.pop-box').find('.modal_title').text('أسناد المهمة');
                }
                if(CurrentEmp !="0")
                {
                    $("#ddlEmployees option[value=" + CurrentEmp + "]").hide();
                }
                Modal.showMessage(' إعاده أسناد المهمة', 'لا يمكن أسناد المهمة الا بعد تحديد تاريخ البدايه والنهايه');
            }
            else
            {

                if(HijridateCompare($('#dtEndDate').val(), GregORHijriiDateNow) < 0){

                    $('#btnUpdateTask').click();
                }
                else{
                    if(CurrentEmp=="0")
                    {
                        $("#dialogForm").closest('.pop-box').find('.modal_title').text('أسناد المهمة');
                    }
                    if(CurrentEmp !="0")
                    {
                        $("#ddlEmployees option[value=" + CurrentEmp + "]").hide();
                    }
                    $('#btnUpdateTask').click();
                    modal.show(); //open the  modal
                }
            }
        });
        //Handle Close Reassign poup or
        $('.closepopup, .btnClose').click(function (e) {
            e.preventDefault();
            $('#ddlEmployees').val(0); // reset emp DropDownList value
            $('#error')[0].innerHTML =""; //ClearValidation Text
            modal.hide(); // hides the modal
        });
        //Handle  confirmation button to reassign tasks.
        $('#btnConfirm').click(function () {
            debugger
            //validate  Required Validation onEmpValue
            if ($('#ddlEmployees').val() == 0) {
                $('#error')[0].innerHTML = "يجب أختيار موظف";
            }
                //Validate not to the Same Employee Reassign
            else if ($('#ddlEmployees').val() ==CurrentEmp )
            {
                $('#error')[0].innerHTML = "لا يمكن إعاده أسناد لنفس الموظف";
            }
            else //Case Valid Data
            {
                debugger
                $('#error').innerHTML = ""; //Clear Validation Text
                var url = "/Common/Common/ReAssignTask";// ReassignUrl
                $.post(url, { taskID: '@Model.TaskID', iEmployeeID: $('#ddlEmployees').val() }, function (data) {
                    if (data == 'True') {
                        debugger

                        //Set CurrentEmp with new value
                        CurrentEmp = $('#ddlEmployees').val() ;
                        $("#ddlEmployees option").show();
                        //update UI
                        $('#td_EmpName')[0].innerHTML = $('#ddlEmployees option:selected').text();

                        //Clear Employee dropDown Value
                        $('#ddlEmployees').val(0);
                        //Clear Error
                        $('#error')[0].innerHTML ="";
                    }else
                    {
                        debugger

                    }
                    //closePopUP
                    modal.hide();
                });
            }
        });
        //***********************************F O R  P E N D / U N P E N D  S C E N A R I O *********************************//
        //Handle PendTask Click
        $('.pend').live('click', function (e) {
            debugger
            var elem = $(e.target);
            //     var elem=$(event.target);
            if (elem.hasClass('icon-pause-1'))
            {
                // elem=($(event.target).parent());
                elem=($(e.target).parent());
            }

            //Set PendTask URL
            var url = "/Common/Common/PendTask";
            $.post(url, { taskID: '@Model.TaskID'}, function (data) {
                if (data == 'True') {
                    debugger
                    //Incase of Sucess
                    //UPdateUI
                    elem.removeClass("pend");
                    elem.addClass("unpend");
                    elem.find(".icon-pause-1").removeClass("icon-pause-1").addClass("icon-play-1");
                    $('#td_CurrentStatus')[0].innerHTML ='معلقة';

                    //Toggle PEND and unpend
                    elem.attr('title','إعادة تفعيل');
                    elem.attr('data-original-title','إعادة تفعيل');

                }
            });
            elem.unbind('click');
        });

        //Handle UnpendTask Click
        $('.unpend').live('click',function(e) {
            debugger
            // var elem=$(event.target);
            var elem = $(e.target);
            if (elem.hasClass('icon-play-1'))
            {
                elem=($(e.target).parent());
            }
            if(HijridateCompare($('#dtEndDate').val(), GregORHijriiDateNow) < 0){

                $('#btnUpdateTask').click();
            }
            else{
                debugger
                //Set UNPend URL
                var url = "/Common/Common/UnPendTask";
                $.post(url, { taskID: '@Model.TaskID' }, function(data) {
                    if (data) {
                        debugger
                        //Incase of Sucess
                        //UPdate UI
                        elem.removeClass("unpend");
                        elem.addClass("pend");
                        elem.find(".icon-play-1").removeClass("icon-play-1").addClass("icon-pause-1");
                        $('#td_CurrentStatus')[0].innerHTML = data;
                        $('#td_CurrentDelay')[0].innerHTML ='لا';
                        //Toggle PEND and unpend

                        elem.attr('title','إيقاف');
                        elem.attr('data-original-title','إيقاف');
                        $('#btnUpdateTask').click();
                    }
                });

                $(".modal_btn_accept").show();
                Modal.showMessage('اعادة تفعيل', 'تم التفعيل المهمة بنجاح.');
            }

            //modal.show();

            elem.unbind('click');

        });

        //********************F O R  T A S K  A P P R O V E  A N D  U N A P P R O V E***********************//
        //Handle Company/Employee Approve EndTask
        $(document).on('click', '.Approve', function(){
