     <script>
         $(function () {
           
             $("#TimeUnitID").change(function (evt) {
                 debugger
                 var val = $(this).val();
                 if ($(this).val() == "") {
                     $('#TimeExpectedID').rules("remove");  
                     $('#TimeExpectedID').removeClass("{required:true,messages:{required:'الوقت المقدر مطلوب'}}");
                     $("#ExpectedTimeValidation").remove();
                     $('#TimeExpectedID').removeClass("input-validation-error");
                     $('#TimeExpectedID').attr("disabled", "disabled");
                 }
                 else {
                     $('#TimeExpectedID').removeAttr("disabled");
                     $('#TimeExpectedID').rules("add", { required: true, messages: { required: "الوقت المقدر مطلوب" } });                 }
             });

            $("#TitleValidation").text("");
            $(".form-textbox").removeClass("input-validation-error");
            if ('@((Model != null) && Model.Saved.HasValue && Model.Saved.Value &&  Model.RecaptchCheck.HasValue && Model.RecaptchCheck.Value)' == 'True') 
                {
                    Notify("success", "تم الحفظ بنجاح", 3000);
                    window.location.href = "/Common/Common/Index";
                }

            if ('@((Model != null) && Model.Saved.HasValue && Model.Saved.Value &&  !Model.RecaptchCheck.HasValue)' == 'True') {
                Notify("success", "تم الحفظ بنجاح", 3000);
                window.location.href = "/Common/Common/Index";
            }

            if ('@((Model != null) && Model.RecaptchCheck.HasValue && !Model.RecaptchCheck.Value)' == 'True')
                {
                Notify("danger", "تم حفظ بيانات المهمة ولم يتم حفظ المرفقات يرجى تعديل المهمة والضغط على رمز التحقق", 3000);
               
                setTimeout(function () { window.location.href = "/Common/Common/Index"; }, 3000);
            }

            if ('@((Model != null) && Model.Saved.HasValue && !Model.Saved.Value)' == 'True')
                Notify("danger", "لم يتم الحفظ بنجاح", 3000);

            // Add Calendar To TextBoxs .
           

             //Check Date Greg OR Hijrii
            var Isgreg = "@(MvcApplication.IsGregDate)";              
            if (Isgreg == "True") {
                $('#dtEndDate').datepicker($.datepicker.regional["ar-SA"]);
                $('#dtStartDate').datepicker($.datepicker.regional["ar-SA"]);
            }
            else {
                $('#dtEndDate,#dtStartDate').calendarsPicker({
                    changeMonth: true,
                    changeYear: true,
                    showTrigger: '#calImg',
                    calendar: $.calendars.instance('ummalqura'),
                    dateFormat: 'dd/mm/yyyy'
                });
            }
            // Change Color Of Priority .
            $('#PriorityID').change(function () {
                $('.strenth-colors').css("width", ($(this).find(":selected").attr("value") * 22) + "px");
            });

            var fileCount = '@((Model == null || Model.Attachment == null) ? 0 : Model.Attachment.Count())';

            // Add Files To Attachments Table .
            //$("#btnAddFile").click(function () {
            function AddFile() {
                debugger
                $("#recap").show();
                $('#btnCancelFile').hide();
                $("#errorUploadFile").hide();
                $("#errorDescFile").hide();

                // To Check Jquery Validation 350 char. .
                if ($('#txtFileDesc').hasClass('input-validation-error')) {
                    $('#errorDescFile').show();
                    return false;
                }

                // To Check If User Select File Or Not .
                if ($("#TaskFileUploader").val() == "") {
                    $("#errorUploadFile").show();

                }
                else
                {
                    debugger
                    fileCount++;
                    console.log(fileCount);
                    // Create New Input Type File To Get Values In Controller By Request .
                    var real = $("#TaskFileUploader");
                    var cloned = real.clone(true);

                    real.hide().attr("id", "TaskFileUploader" + fileCount);
                    cloned.insertAfter(real);

                    $(".AttachedFiles").append('<tr>' +
                        '<td width="15%" class="srch-lbl">الملف :</td>' +
                        '<td width="85%">' +
                        '<a href="javascript:void(0);" style="font-size:15px;">' + $("#fileName").html() + '</a>' +
                        '<a href="javascript:void(0);" class="Delete-icon deleteFile NewFile" title="حذف" style="float:left;"></a>' +
                        '<td>' +
                        '</tr>' +
                        '<tr class="desc-row">' +
                        '<td class="srch-lbl">الوصف :</td>' +
                        '<td>' +
                        '<span id="filedesc' + fileCount + '" class="Description">' + $("#txtFileDesc").val() + '</span>' +
                        '</td>' +
                        '</tr>');

                    $("#filedesc" + fileCount).after(real);

                    $("#fileName").hide();
                    $("#fileName").html("");
                    $("#UploadFile").show();
                    $("#txtFileDesc").val("");
                }
            }

            // To View Browse Window .
            $("#UploadFile").click(function () {
                debugger
                $("#TaskFileUploader").click();
            });

            // To Detect If User Select File Or Not .
            $("#TaskFileUploader").change(function (evt) {
                console.log(fileCount);
                debugger
                $("#errorUploadFile").hide();

                if ($(this).val() != null) {
                    var files = evt.target.files;
                    var Extentions = "@System.Configuration.ConfigurationManager.AppSettings["FileExtentions"]";
                    var size = "@System.Configuration.ConfigurationManager.AppSettings["maxfileSize"]";
                    var fileType = "";
                    var picReader = new FileReader();
                    if (files.length > 0) {
                        picReader.readAsBinaryString(files[0]);
                        var fileNameIndex = $(this).val().lastIndexOf("\\") + 1;
                        $("#fileName").show();
                        $("#fileName").html($(this).val().substr(fileNameIndex));
                        $("#UploadFile").hide();
                        $('#btnCancelFile').show();
                    }
                    picReader.onload = function (e) {
                        
                        fileType = e.target.result.trim().substring(0, 10);

                        if (files.length > 0) {
                            var ext = files[0].name.split('.').pop().toLowerCase();

                            var bReturn = CheckIsValid(Extentions, ext, fileType);
                            if (bReturn == false) {
                                $('.errorUploadFile').text('غير مسموح بنوع الملف').css('color', 'red');
                                $('#btnCancelFile').hide();
                                $('#TaskFileUploader').val('');
                                $('.errorUploadFile').show();
                                $("#fileName").hide();
                                $("#fileName").html("");
                                $("#UploadFile").show();
                                $("#txtFileDesc").val("");
                                return false;
                            }
                            else if (files[0].size > size) {
                                $('.errorUploadFile').text('يجب ان لا يتجاوز حجم الملف 4 ميجا').css('color', 'red');
                                $('#btnCancelFile').hide();
                                $('#TaskFileUploader').val('');
                                $('.errorUploadFile').show();
                                $('#btnCancelFile').hide();
                                $("#fileName").hide();
                                $("#fileName").html("");
                                $("#UploadFile").show();
                                $("#txtFileDesc").val("");
                                return false;
                            }
                            else {
                                var reader = new window.FileReader();
                                reader.onload = (function () {
                                    return function (e) {
                                        $('.errorUploadFile').text('');
                                        AddFile();
                                        $('.errorUploadFile').text('تم رفع الملف بنجاح').css('color', 'green');
                                        $('.errorUploadFile').show();
                                        //$('#hiddenfileName').val(files[0].name);
                                        //$('#trUploadvalidation')[0].innerHTML = '';
                                    };
                                })(files[0]);
                                reader.readAsDataURL(files[0]);
                            }
                        }
                    };


                    $.validator.addMethod("maxfilesize", function (value, element) {
                        return element.files[0].size < 1024 * 1024 * 2;
                    }, 'حجم هذا الملف لايمكن ان يتجاوز 2 ميجابايت');

                    $.validator.addMethod("limitfiletype", function (value, element) {

                        var ext = value.split('.').pop().toLowerCase();
                        return ext == 'jpg' || ext == 'jpeg' || ext == 'png';
                    }, 'امتداد هذا الملف غير مسموح به');
                }

            });
            function CheckIsValid(Extentions, ext, fileType) {
                debugger
                var valid = false;

                if (Extentions.indexOf(ext) >= 0) {
                    //for pdf, PDF
                    if (fileType.indexOf("%PDF") >= 0) {
                        valid = true;
                    }
                        //DOCX, PPTX, XLSX
                    else if (fileType.indexOf("PK") >= 0) {
                        valid = true;
                    }
                        //DOC, DOT, PPS, PPT, XLA, XLS, WIZ
                    else if (fileType.indexOf("ÐÏ.à¡±.á") >= 0 || fileType.indexOf("ÐÏà¡±á") >= 0) {
                        valid = true;
                    }
                        //JFIF, JPE, JPEG, JPG
                    else if (fileType.indexOf("ÿØÿà") >= 0) {
                        valid = true;
                    }
                        //PNG
                    else if (fileType.indexOf("PNG") >= 0) {
                        valid = true;
                    }

                }
                else { valid = false; }
                return valid;
            }
            // Remove File From Attachments Table And Add It Into Hidden Filed To Delete File From Server And DB in Controller.
            $('.deleteFile').live("click", function () {

                if (!$(this).hasClass("NewFile"))
                    $("#RemovedFiles").val($("#RemovedFiles").val() + "," + $(this).prev().html());
                $("#attach-files").find('tbody').append('<p class="DeleteSuccess" style="color:green">تم الحذف بنجاح</p>');
                $(".DeleteSuccess").hide().fadeIn(1000).fadeOut(3000);
                $(this).parent().parent().next().remove();
                $(this).parent().parent().remove();

            });

            // Save Task .
            $("#btnSave").click(function () {
                debugger
                //$("#SaveData").attr("disabled", "disabled");
                var submit = false;
                if ($("#Titletext").val() == "")
                {
                    $("#TitleValidation").text("يجب ان لا تترك الخانات فارغة");
                    $("#Titletext").addClass("input-validation-error");
                }             

                $("#dateError").hide();

                $("#errorUploadFile").hide();

                $('#ExpectedTimeError').hide();

                $("#FilesDescription").val("");

                if ($("#EmpID").val() != ""
                    && (
                        $("#dtStartDate").val() == ''
                            || $("#dtEndDate").val() == '')) {

                    $("#dateError").html(" يجب تحديد تاريخ البداية و النهاية").show();
                    return false;
                }

                // Add File Description Into Hidden Field .
                for (var i = 0; i < $(".Description").length; i++) {
                    $("#FilesDescription").val($("#FilesDescription").val() + "," + $(".Description").eq(i).html());
                }
                debugger
                $.ajax({
                    type: "POST",
                    url: "/TaskCommon/CheckDate",
                    async: false,
                    data: {
                        "dtStartDate": $('#dtStartDate').val(),
                        "dtEndDate": $('#dtEndDate').val()
                    },
                    success: function (data) {
                        debugger
                        if (data != "valid")
                            $('#dateError').html(data).show();

                        else if ($('#dtStartDate').val() != '' && $('#dtEndDate').val() != '' && $('#TimeExpectedID').val() != '' && $('#TimeUnitID').val() != '')
                        {
                            $.ajax({
                                type: "POST",
                                url: "/TaskCommon/DateDifference",
                                async: false,
                                data: {
                                    "dtStartDate": $('#dtStartDate').val(),
                                    "dtEndDate": $('#dtEndDate').val(),
                                    "iTimeCount": $('#TimeExpectedID').val(),
                                    "iTimeUnit": $('#TimeUnitID').find(":selected").attr("value")
                                },
                                success: function (sdata) {
                                    debugger
                                    if (sdata.toLowerCase() == "false") {
                                        debugger
                                        $('#ExpectedTimeError').html('الوقت المقدر أكبر من الوقت المتاح').show();
                                    }
                                    else {
                                        debugger
                                        submit = true;
                                    }
                                },
                                complete: function (data) {
                                    debugger
                                    if ($("#SaveData").valid() && submit) {
                                        $("#btnSave").attr("disabled", "disabled");
                                        $("#SaveData").submit();
                                        //$('form#id').submit(function () {
                                        //    $(this).find('input[type=submit]').attr('disabled', 'disabled');
                                        //});
                                    }
                                }
                            });
                        }
                        else {
                            submit = true;
                        }
                    },
                    complete: function (data) {
                        debugger
                        if ($("#SaveData").valid() && submit) {
                            $(this).attr("disabled", "disabled");
                            $("#SaveData").submit();
                        }
                    }
                });
                //if ($("#SaveData").valid() && submit) {
                //    $(this).attr("disabled", "disabled");
                //    $("#SaveData").submit();
                //}
            });

            //Validation rules.
            $.validator.addMethod("regxVldStr350", function (value, element) {
                return this.optional(element) || /^[a-zA-Z0-9\u0600-\u06ff,./\s_-]{1,350}$/.test(value);
            }, '<br />يجب عدم استخدام رموز خاصة');

            //add validation rule .
            $('#txtFileDesc').rules("add", { regxVldStr350: true });

            $('#btnCancelFile').click(function () {
                $('#btnCancelFile').hide();
                $('#TaskFileUploader').val('');
                $("#fileName").html('');
                $("#UploadFile").show();
                $("#attach-files").find('tbody').append('<p class="DeleteSuccess" style="color:green">تم الحذف بنجاح</p>');
                $(".DeleteSuccess").hide().fadeIn(1000).fadeOut(3000);
            });

            // Copy From Old Task .
            $("#CopyFromOldTask").click(function () {
                CopyDiv.show();
            });


            var CopyDiv = new Modal({
                title: 'نسخ من مهمة اخرى', //title of the popup
                message: 'اختر مهمة ', // message text  notes: overrided if there're  id form
                type: 'confirm',  // type of the modal 'alert', 'confirm' or 'form'
                id: 'CopyFromOldTaskDiv',  // id of the form to show it on the modal
                onAccept: function () {
                    $.ajax({
                        type: "POST",
                        url: "/TaskCommon/GetTask",
                        data: {
                            "taskId": $('#CopyTask').val(),
                        },
                        success: function (data) {
                            console.log(data);                         
                            $('#Titletext').val(data.Title);
                            $('#Description').val(data.Description);
                        }
                    });
                    CopyDiv.hide();
                },// call back runs after modal accept,
                onCancel: function () {
                    CopyDiv.hide();
                } // call back runs after modal cancel default  is false , closes the modal.
            });
        });

    </script>
        
        
