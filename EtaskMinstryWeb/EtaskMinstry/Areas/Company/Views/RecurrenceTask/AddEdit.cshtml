<script>
    // Add Calendar To TextBoxs .
    var recValue = new Object();
    var stringRecVal;
    var text = "";
    var type;
    var monthlytype;
    var yearlytype;
    var RecValueValid = false;
    $(document).ready(function () {
        //Hijri Calender
        $('#StartRec,#EndRec').calendarsPicker({
            changeMonth: true,
            changeYear: true,
            showTrigger: '#calImg',
            calendar: $.calendars.instance('ummalqura'),
            dateFormat: 'dd/mm/yyyy',
            yearRange: '1418:1450'
        });

        $("#btnRecurrence").click(function () {
            $("#RecurrencePopUp").slideToggle();
        });
        $("input[name='RecurrenceTypeID']").live("change", function () {

            type = $(this).val();
            if (type == 1) {
                $(".hide").hide();
            } else if (type == 2) {
                $(".hide").hide();
                $("#weekly").show();
            } else if (type == 3) {
                $(".hide").hide();
                $("#monthly").show();

            } else if (type == 4) {
                $(".hide").hide();
                $("#yearly").show();

            }

        });

        $("input[name='monthly']").live("change", function () {
            monthlytype = $(this).val();
            if (monthlytype == 1) {
                $(".hide").hide();
                $("#monthly").show();
                $("#spanDayInMonthly").show();
            } else if (monthlytype == 2) {
                $(".hide").hide();
                $("#monthly").show();
                $("#spanWeekInMonthly").show();
            }
        });

        $("input[name='yearly']").live("change", function () {
            yearlytype = $(this).val();
            if (yearlytype == 1) {
                $(".hide").hide();
                $("#yearly").show();
                $("#spanDayInYearly").show();
            } else if (yearlytype == 2) {
                $(".hide").hide();
                $("#yearly").show();
                $("#spanWeekInYearly").show();
            }
        });

        @*//@((int)EtaskMinstry.RecurrenceType.Daily) @((int)EtaskMinstry.RecurrenceType.Weekly)
        @((int)EtaskMinstry.RecurrenceType.Monthly) @((int)EtaskMinstry.RecurrenceType.Yearyly)*@
        $("#btnConfirmRecurrunce").live("click", function () {

            if (type == 1) {
                SetDailyRecValue();
            } else if (type == 2) {
                SetWeeklyRecValue();
            } else if (type == 3) {
                SetMonthlyRecValue();
            } else if (type == 4) {
                SetYearlyRecValue();
            }

            $("#txtRecValue").text(text).css("color", "black");
            $("#RecValue").val(stringRecVal);
            RecValueValid= CheckIsValid(type);
        });

        $("#btnSubmitTask").click(function () {
            SubmitForm();
        });

    });
    //Set  Daily Recurrence Task
    function SetDailyRecValue() {
        recValue.Type = "Daily";
        stringRecVal = JSON.stringify(recValue);
        text = "نوع التكرار: يومي";
       
    }
    //Set  Weekly Recurrence Task
    function SetWeeklyRecValue() {
        var arrayDays = [];
        var arraytext = [];
        $("#weekly input:checkbox:checked").each(function () {
            arrayDays.push($(this).val());
            arraytext.push($(this).attr("title"));
        });

        recValue.Type = "Weekly";
        recValue.Days = arrayDays;
        stringRecVal = JSON.stringify(recValue);
        text = "نوع التكرار: اسبوعي، الأيام: " + arraytext + "";
    }
    //Set  Monthly Recurrence Task
    function SetMonthlyRecValue() {
        recValue.Type = "Monthly";
        if (monthlytype == 1) {
            recValue.Date = $("#DayInnMonth").val();
            text = "نوع التكرار: شهري، اليوم: " + recValue.Date + "";
        } else if (monthlytype == 2) {
            recValue.DayWeek = $("#DayWeek").val();
            recValue.Week = $("#week").val();
            text = "نوع التكرار: شهري، اليوم: " + $("#DayWeek :selected").text() + "، الأسبوع: " + $("#week :selected").text() + "";
        }
        stringRecVal = JSON.stringify(recValue);
    }
    //Set  Yearly Recurrence Task
    function SetYearlyRecValue() {
        recValue.Type = "Yearly";
        if (yearlytype == 1) {
            var day = $("#DayInYear").val();
            var month = $("#MonthInYear").val();
            recValue.Date = day + "/" + month;
            text = "نوع التكرار: سنوي، اليوم: " + day + "، الشهر: " + $("#MonthInYear :selected").text() + "";
        } else if (yearlytype == 2) {
            recValue.DayWeek = $("#DayWeekInYear").val();
            recValue.Week = $("#WeekInYear").val();
            recValue.Month = $("#MonthWeekInYear").val();
            text = "نوع التكرار: سنوي، اليوم: " + $("#DayWeekInYear :selected").text() + "، الأسبوع: " + $("#WeekInYear :selected").text() + "، الشهر: " + $("#MonthWeekInYear :selected").text() + "";

        }
        stringRecVal = JSON.stringify(recValue);
    }

    //Validate Choise
    function CheckIsValid(type) {
        if (type == @((int)EtaskMinstry.RecurrenceType.Daily)) {
            $("#RecurrencePopUp").slideUp();
            return true;
    } else if (type == @((int)EtaskMinstry.RecurrenceType.Weekly)) {
            if ($("#weekly input:checkbox:checked").length < 1) {
                $("#txtRecValue").text("يجب اختيار يوم واحد على الأقل").css("color", "red");
                return false;
            }
            else {
                $("#RecurrencePopUp").slideUp();
                return true;
            }
    } else if (type == @((int)EtaskMinstry.RecurrenceType.Monthly)) {
            if ($("input[name='monthly']:checked").length < 1) {
                $("#txtRecValue").text("يجب اختيار نمط التكرار").css("color", "red");
                return false;
            }
            else {
                $("#RecurrencePopUp").slideUp();
                return true;
            }
    } else if (type == @((int)EtaskMinstry.RecurrenceType.Yearyly)) {
            if ($("input[name='yearly']:checked").length < 1) {
                $("#txtRecValue").text("يجب اختيار نمط التكرار").css("color", "red");
                return false;
            }
            else {
                $("#RecurrencePopUp").slideUp();
                return true;
            }
        }
 }

    function SubmitForm() {
        var FormIsValid = $("#recurrenceForm").valid();
        if (RecValueValid && FormIsValid) {
            if ($("input:checkbox:checked").length > 0) {
                $("#recurrenceForm").submit();
            } else {
                $("#txtValidEmployee").text("يجب اختيار موظف واحد على الأقل").css("color", "red");
            }
        } else {
            $("#txtRecValue").text("يجب اختيار نمط التكرار و بطريقة صحيحة").css("color", "red");
            if ($("input:checkbox:checked").length <= 0)
                $("#txtValidEmployee").text("يجب اختيار موظف واحد على الأقل").css("color", "red");
            else
                $("#txtValidEmployee").text("");
        }
    
   
    }
</script>

