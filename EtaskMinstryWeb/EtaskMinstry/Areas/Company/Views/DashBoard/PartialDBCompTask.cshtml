@using EtaskMinstry
@model IEnumerable<EtaskMinstry.Models.Company.DaskBoardCompanyTaskVM>
@if (Model.Any())
{

    <div id="list" class="table-responsive">
        @{
            var grid = new WebGrid(Model);
            var gridColumns = new List<WebGridColumn>();


            gridColumns.Add(grid.Column("Task", "المهمة", @<text><span class="bidi-text">@Html.EncodedActionLink((string)@item.Task, "TaskDetails", "Company", "Company", new { id = @item.TaskID, IsRoute = true }, null)</span>


            </text>, "FirstColumn"));
     gridColumns.Add(grid.Column("Link", "الرابط", @<text><a class="copy_text" data-toggle="tooltip" title="نسخ الرابط " href="@ViewContext.Controller.ViewBag.domain/Company/Company/TaskDetails/@item.TaskID">نسخ الرابط </a></text>, "Link"));

if (Model.All(i => i.DBStatus == EtaskMinstry.AppCode.DashBoaedTaskType.Delayed))
{

gridColumns.Add(grid.Column("EmpName", "الموظف", @<text>@item.EmpName</text>, "FirstColumn"));
gridColumns.Add(grid.Column("Status", "الحالة", @<text>@item.Status</text>, "FirstColumn"));
gridColumns.Add(grid.Column("Delay", "مدة التأخير", @<text>@item.delayTime</text>, "FirstColumn"));



}

else if (Model.All(i => i.DBStatus == EtaskMinstry.AppCode.DashBoaedTaskType.Empfinish))
{
gridColumns.Add(grid.Column("EmpName", "الموظف", @<text>@item.EmpName</text>, "FirstColumn"));

gridColumns.Add(grid.Column("StartDate", "تاريخ التسليم", @<text>@item.HijriFinishDate </text>, "FirstColumn"));



gridColumns.Add(grid.Column("Delayed", " متأخرة", @<text> @(item.IsDelayed ? "نعم" : "لا") </text>, "FirstColumn"));


gridColumns.Add(grid.Column("Accept", "اعتماد", @<text><a taskid="@item.TaskID" href="javascript:void(0);" class="inline-action-link has-tip Approve" title="قبول">
            <i class="fa fa-check-circle"></i>
        </a></text>, "FourthColumn"));

gridColumns.Add(grid.Column("Refused", "رفض", @<text><a taskid="@item.TaskID" href="javascript:void(0);" class="inline-action-link has-tip UnApprove" title="رفض">
            <i class="fa fa-remove"></i>
        </a></text>, "fivethColumn"));

}

else if (Model.All(i => i.DBStatus == EtaskMinstry.AppCode.DashBoaedTaskType.EmpReject))
{
gridColumns.Add(grid.Column("EmpName", "الموظف", @<text>@item.EmpName</text>, "FirstColumn"));

gridColumns.Add(grid.Column("StartDate", "تاريخ البداية", @<text>@item.HijriStartDate </text>, "FirstColumn"));
gridColumns.Add(grid.Column("RejectedDate", "تاريخ الرفض", @<text>@item.HijriRejectedDate </text>, "FirstColumn"));

    @*reassign*@
    @*gridColumns.Add(grid.Column("ReAssign", "إعادة إسناد", @<text><a TaskID="@item.TaskID" CurrentEmp ="@item.EmpID" startdate="@item.StartDate" enddate"@item.EndDate"  href="javascript:void(0);" class="inline-action-link has-tip assign" title="إعادة إسناد">
        <i class="icon-retweet"></i>
    </a>
        </text>, "FourthColumn"));*@


