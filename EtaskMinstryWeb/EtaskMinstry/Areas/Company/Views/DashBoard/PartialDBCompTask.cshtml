else if (Model.All(i => i.DBStatus == EtaskMinstry.AppCode.DashBoaedTaskType.New))
{
    gridColumns.Add(grid.Column("EmpName", "الموظف", @<text>@item.EmpName</text>, "FourthColumn"));
gridColumns.Add(grid.Column("FinishDate", "تاريخ البداية", @<text>@item.HijriStartDate </text>, "FourthColumn"));
gridColumns.Add(grid.Column("FinishDate", "تاريخ النهاية", @<text>@item.HijriEndDate </text>, "FourthColumn"));



gridColumns.Add(grid.Column("Accept", "مؤشرالتقدم", @<text>
        <div class="strenth-bar strenth-bar2"><div class="strenth-colors" style="width: @item.DelayPercentage%;"></div></div>
    </text>, "barCol"));



}


        }

        @grid.GetHtml(columns: gridColumns.ToArray(),
                  tableStyle: "table table-bordered dataTable  ",
                 headerStyle: "",
                 footerStyle: "pagerbar",
                 mode: WebGridPagerModes.All,
                 numericLinksCount: 5,
                 firstText: "الاول",
                 previousText: "السابق",
                 nextText: "التالى",
                 lastText: "الاخير"

        )

        @* Custom Pager *@
        <div class="custom-pager text-center mt-3">
            @if (ViewBag.pagesNumber > 1)
            {
                <ul class="pagination">

                    @* First Page *@
                    <li class="page-item @(ViewBag.page == 1 ? "disabled" : "")">
                        <a class="page-link" href="javascript:GetTasksbypage(1,@ViewBag.taskType);">الأول</a>
                    </li>

                    @* Previous Page *@
                    <li class="page-item @(ViewBag.page == 1 ? "disabled" : "")">
                        <a class="page-link" href="javascript:GetTasksbypage(@(ViewBag.page - 1),@ViewBag.taskType);">السابق</a>
                    </li>

                    @* Page Numbers *@
                    @*@for (int i = 1; i <= ViewBag.pagesNumber; i++)
        {
            <li class="page-item @(i == ViewBag.page ? "active" : "")">
                <a class="page-link" href="javascript:GetTasksbypage(@i,@ViewBag.taskType);">@i</a>
            </li>
        }*@

                    <li class="page-item active">
                        <a class="page-link" href="javascript:GetTasksbypage(@ViewBag.page,@ViewBag.taskType);">@ViewBag.page</a>
                    </li>

                    @* Next Page *@
                    <li class="page-item @(ViewBag.page == ViewBag.pagesNumber ? "disabled" : "")">
                        <a class="page-link" href="javascript:GetTasksbypage(@(ViewBag.page + 1),@ViewBag.taskType);">التالي</a>
                    </li>

                    @* Last Page *@
                    <li class="page-item @(ViewBag.page == ViewBag.count ? "disabled" : "")">
                        <a class="page-link" href="javascript:GetTasksbypage(@ViewBag.pagesNumber,@ViewBag.taskType);">الأخير</a>
                    </li>

                </ul>
            }
        </div>

    </div>
}
else
{
    @*--------------------Start Table when no data found----------------*@
    <div class="panel panel-default">

        <div class="datatable-tasks">
            <table class="table table-bordered">
                <thead>

                </thead>
                <tbody>
                    <tr>
                        <td colspan="1" style="text-align: center">
                            لا يوجد بيانات
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
    @*--------------------End Table when no data found----------------*@



}
<script>
    $(document).ready(function () {

        $('.copy_text').click(function (e) {
            e.preventDefault();
            var copyText = $(this).attr('href');

            document.addEventListener('copy', function (e) {
                e.clipboardData.setData('text/plain', copyText);
                e.preventDefault();
            }, true);

            document.execCommand('copy');
            console.log('copied text : ', copyText);

        });

     
    });

    
    </script>