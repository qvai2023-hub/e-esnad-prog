    @*reassign*@
    @*gridColumns.Add(grid.Column("Assign", " إسناد", @<text>
            @if (item.StartDate == null || item.EndDate==null)
                {
    <a>
            </a>
                }
                else
                {
    <a TaskID="@item.TaskID" CurrentEmp ="@item.EmpID" startdate="@item.StartDate" enddate"@item.EndDate" href="javascript:void(0);" class="inline-action-link has-tip assign" title=" إسناد">
                <i class="icon-retweet"></i>
            </a>           }

                </text>, "FourthColumn"));*@

    gridColumns.Add(grid.Column("Delete", "حذف", @<text><span class="test" title="" data-original-title="حذف">
            <i class="fa fa-trash" currenclass="Task" id="@item.TaskID"></i>
        </span></text>, "FourthColumn"));
}
else if (Model.All(i => i.DBStatus == EtaskMinstry.AppCode.DashBoaedTaskType.Susspended))
{
