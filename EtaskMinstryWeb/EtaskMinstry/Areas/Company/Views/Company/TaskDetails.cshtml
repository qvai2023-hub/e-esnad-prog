            if(HijridateCompare('@Model.EndDate', GregORHijriiDateNow) < 0){

                // $('#btnUpdateTask').click();

                var isValid = true;
                isValid=  getValidTaskData("reassign");
            }
            else{
                debugger
                //Set UNPend URL
                var url = "/Company/Company/UnPendTask";
                $.post(url, { taskID: '@Model.TaskID' }, function(data) {
                    if (data) {
