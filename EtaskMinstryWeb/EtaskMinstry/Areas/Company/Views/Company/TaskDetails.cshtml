        //***************************F O R  E D I T  T A S K  I N F O  *********************************//
        $("#txtDuration").keydown(function(e){
            var key = e.which;

            // backspace, tab, left arrow, up arrow, right arrow, down arrow, delete, numpad decimal pt, period, enter
            if (key != 8 && key != 9 && key != 37 && key != 38 && key != 39 && key != 40 && key != 46 && key != 110 && key != 190 && key != 13){
                if (key < 48){
                    e.preventDefault();
                }
                else if (key > 57 && key < 96){
                    e.preventDefault();
                }
                else if (key > 105) {
                    e.preventDefault();
                }
            }
        });

        var startdate ;
        var ProjectID;
        function getValidTaskData(btn) {
            debugger;

            var retval;
            var isValid = true;
            if ('@(Model.StatusID == (int)TaskStatus.New)'=='True')
            {
                var regxDescription  = "[^<>]{1,}$";
                var txtDes=$('#txtDesc').val();
                if(txtDes!="")
                {
                    var matchDescription = $('#txtDesc').val().match(regxDescription);
                    if (matchDescription == null) {
                        $('#vldDescription')[0].innerHTML= " غير مسموح بكتابه رموز خاصه";
                        isValid=false
                    }
                }
                else {  $('#vldDescription')[0].innerHTML= "";}


            }

            var GregORHijriiDateNow;
            var Isgreg ="@(MvcApplication.IsGregDate)";
            if(Isgreg=="True")
            {
                GregORHijriiDateNow='@QvLib.QVUtil.Date.GDateNow("dd/MM/yyyy")';
            }
            else
            {
                GregORHijriiDateNow='@QvLib.QVUtil.Date.HDateNow("dd/MM/yyyy")';
            }

            //Clear Validators
            if( '@(Model.StatusID != (int)TaskStatus.Inprogress && Model.StatusID != (int)TaskStatus.Pending && Model.StatusID != (int) TaskStatus.Accepted && Model.StatusID !=(int)TaskStatus.Rejected && Model.StatusID != (int)TaskStatus.NotAproved)'   == 'True')
            {
                startdate = $('#dtStartDate').val();

                if( typeof  ($('#vldStartDate')[0]) === 'undefined' || ($('#vldStartDate')[0]) === null ){
                    //alert("true");
                }
                else

                { $('#vldStartDate')[0].innerHTML ="";}
            }
            else
                startdate = '@Model.StartDate';
            $('#vldEndDate')[0].innerHTML ="";
            $('#vldDuration')[0].innerHTML ="";
            //Validate Date
            //Notvalidate Inprogress Tasks
            if( '@(Model.StatusID != (int)TaskStatus.Inprogress)' == 'True')
            {
                if($('#dtStartDate').val() =='')
                {
                    //$('#vldStartDate')[0].innerHTML = "يجب الايترك تاريخ البدايه فارغا"
                    //isValid = false;
                }
                else if('@Model.StartDate'=='-' &&  HijridateCompare($('#dtStartDate').val(), GregORHijriiDateNow) < 0)
                {
                    $('#vldStartDate')[0].innerHTML = "تاريخ البدايه يجب وان يكون اكبر من او يساوى تاريخ اليوم";
                    isValid = false;
                }
            }
            //Duration time must be required when ddl time unit has value
            if($("#ddlTimeUnit").val()!="")
            {
                if($("#txtDuration").val()=="" || $("#txtDuration").val()=="0.00")
                {
                    $('#vldDuration')[0].innerHTML ="يجب اختيار وقت مقدر";
                    isValid = false;
                }

                if($("#txtDuration").val()!="")
                {
                    var regxExpectedTime  = "^[0-9]{1,3}([.,][0-9]{1,2})?$";
                    var matchExpectedTime = $('#txtDuration').val().match(regxExpectedTime);
                    if (matchExpectedTime == null) {
                        $('#vldDuration')[0].innerHTML= " ادخل (1-3) رقم قبل العلامة و(1-2) رقم بعد العلامة مثل (12.5 ,0.5) او رقم صحيح";
                        isValid=false
                    }
                }
            }

            if( '@(Model.StatusID != (int)TaskStatus.New)'   == 'True')
            {
                ProjectID = '@Model.ProjectID';
            }
            else
            { ProjectID = $('#ProjectID').val() ; }
            if($('#dtEndDate').val() =='')
            {
                //$('#vldEndDate')[0].innerHTML = "يجب الايترك تاريخ النهاية فارغا"
                //isValid = false;
            }
            else if(  HijridateCompare($('#dtEndDate').val(), GregORHijriiDateNow) < 0)
            {
                $('#vldEndDate')[0].innerHTML = "تاريخ النهاية يجب وان يكون اكبر من او يساوى تاريخ اليوم";
                isValid = false;
            }
            else  if(   HijridateCompare($('#dtEndDate').val(), startdate ) < 0)
            {
                $('#vldEndDate')[0].innerHTML = "تاريخ النهاية يجب وان يكون اكبر من او يساوى تاريخ البدايه";
                isValid = false;
            }


            if(btn == "reassign" && isValid && HijridateCompare('@Model.EndDate', GregORHijriiDateNow) < 0){
                $('#vldEndDate')[0].innerHTML = "يجب تاكيد تعديل تاريخ النهاية";

            }
            return retval =isValid;
        }



