<script>

    $(function () {




        var approvConfirmation;

            $('.Archive-icon').click(function (e) {
                e.preventDefault();
            debugger;
            var iTaskid = $(this).attr('iTaskID');

            approvConfirmation = new Modal({
                title: 'تأكيد', //title of the popup
                message: 'هل انت متأكد من نقل المهمة الى الارشيف ؟', // message text  notes: overrided if there're  id form
                type: 'confirm',  // type of the modal 'alert', 'confirm' or 'form'
                id: '',  // id of the form to show it on the modal
                onAccept: function () {
                    $.ajax({
                        type: 'Post',
                        url: '@Url.Action("Archive")',
                        dataType: 'json',
                        data: { iTaskID: iTaskid },
                        success: function (data) {
                        },
                        error: function (e) {
                        },
                        complete: function (data) {
                            if (data.responseText.toLowerCase() == "true") {
                                Notify("success", "تم نقل المهمة بنجاح", 3000);
                                $("#btnSearch").click();
                            } else
                                Notify("danger", "لم تتم العملية بنجاح", 3000);
                        }
                    });

                    approvConfirmation.hide();
                },// call back runs after modal accept,
                onCancel: function () {
                    approvConfirmation.hide();
                } // call back runs after modal cancel default  is false , closes the modal.
            });
            approvConfirmation.show();

        });

        $('.accepted-icon').click(function () {

            var iTaskid = $(this).attr('taskid');

            approvConfirmation = new Modal({
                title: 'تأكيد', //title of the popup
                message: 'هل انت متأكد من اعتماد المهمة ؟', // message text  notes: overrided if there're  id form
                type: 'confirm',  // type of the modal 'alert', 'confirm' or 'form'
                id: '',  // id of the form to show it on the modal
                onAccept: function () {

                    $.ajax({
                        type: 'Post',
                        url: '@Url.Action("AcceptTask")',
                        dataType: 'json',
                        data: { iTaskID: iTaskid },
                        success: function (data) {
                        },
                        error: function (e) {
                        },
                        complete: function (data) {
                            if (data.responseText.toLowerCase() == "true") {
                                Notify("success", "تم اعتماد المهمة بنجاح", 3000);
                                $("#btnSearch").click();
                            } else
                                Notify("danger", "لم تتم العملية بنجاح", 3000);
                        }
                    });

                    approvConfirmation.hide();
                },// call back runs after modal accept,
                onCancel: function () {
                    approvConfirmation.hide();
                } // call back runs after modal cancel default  is false , closes the modal.
            });
            approvConfirmation.show();

        });

        $('.refused-icon').click(function () {

            var iTaskid = $(this).attr('taskid');

            approvConfirmation = new Modal({
                title: 'تأكيد', //title of the popup
                message: 'هل انت متأكد من رفض المهمة ؟', // message text  notes: overrided if there're  id form
                type: 'confirm',  // type of the modal 'alert', 'confirm' or 'form'
                id: '',  // id of the form to show it on the modal
                onAccept: function () {

                    $.ajax({
                        type: 'Post',
                        url: '@Url.Action("RefusedTask")',
                        dataType: 'json',
                        data: { iTaskID: iTaskid },
                        success: function (data) {
                        },
                        error: function (e) {
                        },
                        complete: function (data) {
                            if (data.responseText.toLowerCase() == "true") {
                                Notify("success", "تم رفض المهمة بنجاح", 3000);
                                $("#btnSearch").click();
                            } else
                                Notify("danger", "لم تتم العملية بنجاح", 3000);
                        }
                    });
                    approvConfirmation.hide();
                },// call back runs after modal accept,
                onCancel: function () {
                    approvConfirmation.hide();
                } // call back runs after modal cancel default  is false , closes the modal.
            });
            approvConfirmation.show();
        });


    });


    //to add color for each row according to priority.

    function loadColor() {
        var action = $('form').attr('action').split('?')[0];
        $('priorityId').val(0);
        $('form').attr('action', action);
        $('#list table tr').each(function (index, elm) {
            var elm = $(elm).find('input[type=hidden].priorityColor');
            var elmVal = elm.val();
            elm.closest('tr').css('background-color', elmVal);
        });
    }

    loadColor();
    applyClassesToWebGrid();

    // Replace "تحديد" header text with select-all checkbox
    $('#list table thead th').each(function () {
        if ($.trim($(this).text()) === 'تحديد') {
            $(this).html('<input type="checkbox" id="chkSelectAll" title="تحديد الكل" />');
        }
    });

