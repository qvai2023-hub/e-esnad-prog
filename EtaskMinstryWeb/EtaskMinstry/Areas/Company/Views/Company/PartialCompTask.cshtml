@using EtaskMinstry
@using EtaskMinstry.Models
@model PagedResult<EtaskMinstry.Models.Company.CompanyTaskVM>
@if (Model != null && Model.Items.Any())
{
    <div id="list" class="table-responsive">
        @{
            // Bug #36 — server-side pagination.
            // We pass rowCount = current page size, totalRowCount = total across all pages.
            // WebGrid uses these to render numbered pager links that trigger full-page navigation
            // back to /Company/Company/Index?page=N (handled by Index() action).
            var grid = new WebGrid(
                source: Model.Items,
                rowsPerPage: Model.PageSize,
                canPage: true,
                canSort: false);
            grid.Bind(source: Model.Items, rowCount: Model.TotalCount, autoSortAndPage: false);
            var gridColumns = new List<WebGridColumn>();

// Show checkbox column only for New tasks tab
if (Model.Items.All(i => i.StatusID == (int)TaskStatus.New))
{
            gridColumns.Add(grid.Column("Select", "تحديد",
                format: @<text><input type="checkbox" class="chkTask" value="@item.TaskID" data-statusid="@item.StatusID" /></text>, style: "text-center", canSort: false));
}

            gridColumns.Add(grid.Column("Task", "المهمة",
    @<text>  <strong>
            <span class="bidi-text">@Html.EncodedActionLink((string)@item.Task, "TaskDetails", "Company", "Company", new { id = @item.TaskID, IsRoute = true }, null)</span>
            <input class="" type="hidden" value="@item.RowColor" />
        </strong> </text>, "FirstColumn wordBreak"));

gridColumns.Add(grid.Column("EmpName", "الموظف", @<text>@item.EmpName</text>, "FirstColumn"));

gridColumns.Add(grid.Column("Project", "المشروع", @<text>@item.Project</text>, "FirstColumn"));

gridColumns.Add(grid.Column("Status", "الحالة", @<text>@item.Status<input type="hidden" value="@item.PrioirtyID" /></text>, "FirstColumn"));

gridColumns.Add(grid.Column("StartDate", "تاريخ البداية", @<text>@item.HijriStartDate</text>, "FirstColumn"));

gridColumns.Add(grid.Column("EndDate", "تاريخ النهاية", @<text>@item.HijriEndDate</text>, "FirstColumn"));

gridColumns.Add(grid.Column("FinishedDate", "تاريخ التسليم", @<text>@if (@item.StatusID != (int)TaskStatus.New && @item.StatusID != (int)TaskStatus.Inprogress && @item.StatusID != (int)TaskStatus.Pending)
        {@item.ArabicFinishDate}</text>, "FirstColumn"));

gridColumns.Add(grid.Column("Link", "الرابط", @<text><a class="copy_text" data-toggle="tooltip" title="نسخ الرابط " href="@ViewContext.Controller.ViewBag.domain/Company/Company/TaskDetails/@item.TaskID">نسخ الرابط </a></text>, "Link"));

if (!Model.Items.All(i => i.IsDelayed) && !Model.Items.All(i => i.StatusID == (int)TaskStatus.Done) && !Model.Items.All(i => i.IsArchived)
&& !Model.Items.All(i => i.StatusID == (int)TaskStatus.Rejected) && !Model.Items.All(i => i.StatusID == (int)TaskStatus.NotAproved)
&& !Model.Items.All(i => i.StatusID == (int)TaskStatus.Approved))
{
gridColumns.Add(grid.Column("Progressbar", "المؤشرالزمنى"
,@<text>@if (@item.StatusID == (int)TaskStatus.New || @item.StatusID == (int)TaskStatus.Inprogress)
        {
            <div class="progress progress-micro">
                <div class="progress-bar progress-bar-info" role="progressbar" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100" style="width:@item.Progressbar%;">
                    <span class="sr-only">@item.Progressbar% تم</span>
                </div>
            </div>

        }</text>, "barCol"));
}


String classForDimedPrioirty = "Static-bar";

gridColumns.Add(grid.Column("Prioirty", "الأهمية", @<text><div class='@((@item.StatusID == (int)TaskStatus.Done || @item.IsArchived || @item.StatusID == (int)TaskStatus.Approved) ? classForDimedPrioirty : "priortybar")' title="@item.Prioirty">
            @*<div class="strenth-colors" style="width: @(item.PrioirtyID * 25)%;"></div>*@
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-group" data-toggle="buttons" taskid="@item.TaskID" prioirtyid='@item.PrioirtyID'>
                        @if (@item.PrioirtyID == (int)TaskPriority.Noraml)
                        {

                            <label class="btn btn-xs btn-info active" id="@((int)TaskPriority.Noraml)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-success" id="@((int)TaskPriority.Average)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-warning" id="@((int)TaskPriority.High)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-danger" id="@((int)TaskPriority.VeryHigh)">
                                <input type="radio" name="options">
                            </label>

                        }
                        else if (@item.PrioirtyID == (int)TaskPriority.Average)
                        {

                            <label class="btn btn-xs btn-info " id="@((int)TaskPriority.Noraml)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-success active" id="@((int)TaskPriority.Average)">
                                <input type="radio" name="options ">
                            </label>
                            <label class="btn btn-xs btn-warning" id="@((int)TaskPriority.High)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-danger" id="@((int)TaskPriority.VeryHigh)">
                                <input type="radio" name="options">
                            </label>
                        }
                        else if (@item.PrioirtyID == (int)TaskPriority.High)
                        {
                            <label class="btn btn-xs btn-info " id="@((int)TaskPriority.Noraml)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-success" id="@((int)TaskPriority.Average)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-warning active" id="@((int)TaskPriority.High)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-danger" id="@((int)TaskPriority.VeryHigh)">
                                <input type="radio" name="options">
                            </label>
                        }
                        else
                        {
                            <label class="btn btn-xs btn-info " id="@((int)TaskPriority.Noraml)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-success" id="@((int)TaskPriority.Average)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-warning" id="@((int)TaskPriority.High)">
                                <input type="radio" name="options">
                            </label>
                            <label class="btn btn-xs btn-danger active" id="@((int)TaskPriority.VeryHigh)">
                                <input type="radio" name="options">
                            </label>
                        }
                    </div>
                </div>
            </div>

        </div></text>, "SecondColumn"));

if (!Model.Items.All(i => i.IsArchived))
{
if (!Model.Items.All(i => i.StatusID == (int)TaskStatus.Rejected) && !Model.Items.All(i => i.StatusID == (int)TaskStatus.Approved)
&& !Model.Items.All(i => i.StatusID == (int)TaskStatus.Delay) && !Model.Items.All(i => i.StatusID == (int)TaskStatus.Done)
&& !Model.Items.All(i => i.StatusID == (int)TaskStatus.Inprogress) && !Model.Items.All(i => i.StatusID == (int)TaskStatus.New)
&& !Model.Items.All(i => i.StatusID == (int)TaskStatus.NotAproved) && !Model.Items.All(i => i.StatusID == (int)TaskStatus.Pending))
{
gridColumns.Add(grid.Column("Status", "الارشيف", @<text>@(item.IsArchived ? "نعم" : "لا")</text>, "ThirdColumn"));
}
}


if (Model.Items.All(i => i.IsDelayed))
{
gridColumns.Add(grid.Column("Delay", "مدة التأخير", @<text>@item.Delay</text>, "FirstColumn"));

}

// For Approved Tasks .

if (Model.Items.All(i => i.StatusID == (int)TaskStatus.Approved))
{

gridColumns.Add(grid.Column("Archive", "الأرشيف", @<text>@if (@item.StatusID == (int)TaskStatus.Approved && !@item.IsArchived)
        {
            <a class="Archive-icon" onclick='return Archive(@item.TaskID)' href="#" iTaskID="@item.TaskID" title="نقل إلى الأرشيف"> </a>@*
            @(Ajax.ActionLink(" ", "Archive", new
                                                                           {
                                                                               iTaskID = @item.TaskID
                                                                           }, new AjaxOptions()
                                                                               {
                                                                                   UpdateTargetId = "divTasks",
                                                                                   HttpMethod = "post"
                                                                               }, new
                                                                                   {
                                                                                       @class = "Archive-icon",
                                                                                       title = "نقل إلى الأرشيف"
                                                                                   }))*@
        }
        else
        {
            <a class="Dis-Archive-icon" title="تم نقلها للارشيف" />

        }
    </text>, "FourthColumn"));
}

// For New Tasks .

if (Model.Items.All(i => i.StatusID == (int)TaskStatus.New) && Model.Items.Any(i => i.EmpName != ""))
{
gridColumns.Add(grid.Column("Delete", "حذف",
    @<text><span class="iconbox has-tip" title="" data-original-title="حذف">
            <i href="javascript:void(0);" class="fa fa-trash" currenclass="Task" id="@item.TaskID"></i>
        </span></text>));
}

// For Done Tasks .
if (Model.Items.All(i => i.StatusID == (int)TaskStatus.Done))
{
gridColumns.Add(grid.Column("WorkedHours", "الوقت المستغرق", @<text>@item.SpendtimebyDay</text>, "ForthColumn"));



gridColumns.Add(grid.Column("Accept", "اعتماد", @<text>
        <a taskid="@item.TaskID" href="javascript:void(0);" class="accepted-icon" title="اعتماد المهمة">
            <i class="fa fa-check"></i>
        </a>
    </text>, "FourthColumn"));

gridColumns.Add(grid.Column("Refused", "رفض", @<text>
        <a taskid="@item.TaskID" href="javascript:void(0);" class="refused-icon" title="رفض المهمة">
            <i class="fa fa-close"></i>
        </a>
    </text>, "fivethColumn"));
}
gridColumns.Add(grid.Column("Edit", "تعديل", @<text><a class="fa fa-edit" id="a_@item.TaskID" href="/Company/Task/EDitTask?taskId=@item.TaskID"></a></text>, "EditCol"));
if (!(Model.Items.All(i => i.StatusID == (int)TaskStatus.New) && Model.Items.Any(i => i.EmpName != "")))
{
gridColumns.Add(grid.Column("Delete", "حذف", @<text>
        <a class="fa fa-trash" id="@item.TaskID"></a>
    </text>

    , "DeleteCol"));
}

        }
        @grid.GetHtml(columns: gridColumns.ToArray(),
                       tableStyle: "table table-bordered dataTable ",
         headerStyle: "",
          footerStyle: "pagerbar",
                      mode: WebGridPagerModes.All,
                      numericLinksCount: 5,
                      firstText: "الاول",
                      previousText: "السابق",
                      nextText: "التالى",
                      lastText: "الاخير"
             )
    </div>
}
else
{

    @*--------------------Start Table when no data found----------------*@
 
        
        <div class="datatable-tasks">
            <table class="table table-bordered dataTable  table-responsive">
                <thead>
                <th>المهمه</th>
                <th>المشروع</th>
                <th>تعديل </th>
                <th>حذف </th>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6" style="text-align: center">
                            لا يوجد بيانات
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
  
    @*--------------------End Table when no data found----------------*@

}

