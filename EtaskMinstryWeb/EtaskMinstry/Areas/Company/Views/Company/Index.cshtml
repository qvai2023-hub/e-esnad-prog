                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="row">
                                    <div class="form-group col-sm-6">

                                        <label class="col-sm-4 control-label">الموظف: </label>
                                        <div class="col-sm-8">
                                            @Html.ListBox("EmpIDs", ViewBag.Employee as SelectList,
                                               new
                                               {
                                                   @id = "EmpIDs",
                                                   @class = "chzn-select chzn-rtl form-control",
                                                   @multiple = "multiple",
                                                   data_placeholder = "الكل"
                                               })
