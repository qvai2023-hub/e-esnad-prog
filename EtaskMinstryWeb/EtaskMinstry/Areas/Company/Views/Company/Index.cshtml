                                            </p>
                                        </div>
                                    </div>

                                    <div class="form-group col-sm-6">

                                        @*<span id="spnStatuse">
                                            <label class="rec-lbl" style="margin-right: 30px">الأهمية</label>
                                            <div class="strenth-bar custom-bar">
                                                <div class="progress-bar"  role="progressbar" style="width: 0px"></div>
                                            </div>
                                        </span>*@


                                        <label class="col-sm-4 control-label"> الأهمية: </label>
                                        @*<div class="strenth-bar custom-bar progress">
