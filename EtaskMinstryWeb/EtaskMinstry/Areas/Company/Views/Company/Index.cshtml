                                                <input type="text" id="fromenddate" name="FromEndDate" class="form-control" readonly />
                                                <span class="input-group-addon">
                                                    <span class="fa fa-calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-sm-6">
                                        <label class="col-sm-4 control-label">إلى: </label>
                                        <div class="col-sm-8">
                                            <div class='input-group date'>
                                                @*@Html.TextBox("toDate", null, new { @id = "endDate", @class = "form-control" })*@

                                                <input type="text" id="toendtdate" name="ToEndDate" class="form-control" readonly />
                                                <span class="input-group-addon">
                                                    <span class="fa fa-calendar"></span>
                                                </span>

                                            </div>
                                        </div>
                                        <span class="errorMsg" style="display: none; color: red; margin-right: 85px; margin-top: 5px">يجب ان يكون تاريخ بداية البحث اقل من تاريخ النهاية</span>

                                    </div>
                                </div>
                                <div class="text-right">
                                    <input name="Submit0" id="btnSearch" type="submit" class="btn btn-primary" style="height: 29px;" value="بحث">
                                    <input name="Submit1" id="btnShowAll" type="submit" class="btn btn-primary" style="height: 29px;" value="عرض الكل">
                                </div>
                                    }

                        </div>
                    </div>
                </div>
            </div>
        </div>
            @* --------------------------------------End Search Panel------------------------------------------- *@

      
        @* ---------------------- Start Bulk Actions Toolbar ---------------------- *@
        <div id="bulkActionsBar" style="display:none; padding:10px; margin-bottom:10px; background-color:#f5f5f5; border:1px solid #ddd; border-radius:4px;">
