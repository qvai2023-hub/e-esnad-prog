        <div class="panel-heading">
            <h6 class="panel-title">
                <i class="fa fa-tasks"></i>
                <span>
                    <span class="taptitle">                    </span>

                        <span class="titledynamic">  </span>
                </span>
            </h6>
            @*<span class="pull-right label label-danger">126</span>*@
        </div>
        @* --------------------------------------Start Search Panel----------------------------------------- *@
        <div class="panel-body">
            <div class="panel-group">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h6 class="panel-title panel-trigger">
                            <a data-toggle="collapse" href="#panel-search">بحث</a>
                        </h6>
                    </div>
                    <div id="panel-search" class="panel-collapse collapse">
                        <div class="panel-body">

                            @using (Ajax.BeginForm("GetTasks", "Company"
, new AjaxOptions
{
    InsertionMode = InsertionMode.Replace,
    UpdateTargetId = "divTasks",
    LoadingElementId = "loadding",
    LoadingElementDuration = 30,
