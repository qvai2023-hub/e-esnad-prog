<script>

    $( document ).ready(function() {
        $('#navTabs li').first().addClass('active');
    });

    $(function() {

        //---------------------Start Tap Content Header -----------------
        var navString = $(".active").find('a:first').text();
        //var navCount = $("#navTabs li").find('span:first').text();
        $(".taptitle").html(navString);


        $("#navTabs li").click(function(e){
            var navString =$(this).find('a:first').text();

           $(".taptitle").html(navString);

            //document.getElementById("lblCount").textContent=navCount;

            e.preventDefault();
            $('#navTabs li').removeClass('active');
            $(this).addClass('active');

        });
        //---------------------End Tap Content Header -----------------

        //Check Date Greg OR Hijrii
        var Isgreg ="@(MvcApplication.IsGregDate)";
        if(Isgreg=="True")
        {
            //datepicker Grerg
            //$("#fromstartdate").datepicker($.datepicker.regional[ "ar" ]);
            //$("#tostartdate").datepicker($.datepicker.regional[ "ar" ]);
            //$("#fromenddate").datepicker($.datepicker.regional[ "ar" ]);
            //$("#toendtdate").datepicker($.datepicker.regional[ "ar" ]);
            //
            $('#fromstartdate,#tostartdate,#fromenddate,#toendtdate').calendarsPicker({
                changeMonth: true,
                changeYear: true,
                showTrigger: '#calImg',
                calendar: $.calendars.instance('Gregorian'),
                dateFormat: 'dd/mm/yyyy',
                yearRange: '2021:2050'
            });
        }
        else
        {
            //calendar Hijrii
            $('#fromstartdate,#tostartdate,#fromenddate,#toendtdate').calendarsPicker({
                changeMonth: true,
                changeYear: true,
                showTrigger: '#calImg',
                calendar: $.calendars.instance('ummalqura'),
                dateFormat: 'dd/mm/yyyy',
                yearRange: '1418:1450'
            });
        }

        // Initialize Chosen multi-select for employees
        $("#EmpIDs").chosen({
            placeholder_text_multiple: "اختر الموظف",
            no_results_text: "لا توجد نتائج",
            width: "100%"
        });

        /*$("#btnSearchToggle").click(function () {

            $("#searchdesign").slideToggle("normal");
        });*/
        //in search case fill textbox
        var taskTitle =  "@(Request.QueryString["t"] == null ? "" : Request.QueryString["t"])";
        $("#strTitle").val(taskTitle);

        var currentStatus= @(Request.QueryString["s"] == null ? "0" : Request.QueryString["s"]);
        var isArchive =    "@(Request.QueryString["isArchive"] == null ? "0" : Request.QueryString["isArchive"])";
        var bIsNotAssigned = "@(Request.QueryString["isNotAssign"] == null ? "0" : Request.QueryString["isNotAssign"])";

        $('[datastatus]').not('.subtab').removeClass('active-tab').addClass('dactive-tab');
        if(isArchive == "True"){
            $('[datastatus=Archive]').not('.subtab').removeClass('dactive-tab').addClass('active-tab');
        }else if(bIsNotAssigned== "True" || currentStatus > 5){
            $('[id=more-tasks]').not('.subtab').removeClass('dactive-tab').addClass('active-tab');
        }else{
            $('[datastatus=' + currentStatus + ']').not('.subtab').removeClass('dactive-tab').addClass('active-tab');
        }

        $(".more-tasks").append($('<li>').append($('a[datastatus=@((int)TaskStatus.Approved)]').removeClass('tab').removeClass('dactive-tab').addClass("subtab")));
        $(".more-tasks").append($('<li>').append($('a[datastatus=@((int)TaskStatus.NotAproved)]').removeClass('tab').removeClass('dactive-tab').addClass("subtab")));
        $(".more-tasks").append($('<li>').append($('a[datastatus=@((int)TaskStatus.Accepted)]').removeClass('tab').removeClass('dactive-tab').addClass("subtab")));
        $(".more-tasks").append($('<li>').append($('a[datastatus=@((int)TaskStatus.Rejected)]').removeClass('tab').removeClass('dactive-tab').addClass("subtab")));
        $(".more-tasks").append($('<li>').append($('a[datastatus=@((int)TaskStatus.Delay)]').removeClass('tab').removeClass('dactive-tab').addClass("subtab")));
        $(".more-tasks").append($('<li>').append($('a[datastatus="Assign"]').removeClass('tab').removeClass('dactive-tab')));

        //$(".more-tasks").append($('<li role="presentation" class="divider"></li>'));
        //$(".more-tasks").append($('<li><a href="/Company/Project/">عرض المشروعات</a></li>'));

        $('.tab,.subtab').on('click', function() {
            if ($(this).attr('datastatus') == '@((int)TaskStatus.Approved)')
            {
                $(".titledynamic").html('> معتمدة');
            }
            else if ($(this).attr('datastatus') == '@((int)TaskStatus.NotAproved)')
            {
                $(".titledynamic").html('> غير معتمدة');
            }
            else if ($(this).attr('datastatus') == '@((int)TaskStatus.Accepted)')
            {
                $(".titledynamic").html('> مقبولة');
            }
            else if ($(this).attr('datastatus') == '@((int)TaskStatus.Rejected)')
            {
                $(".titledynamic").html('> مرفوضة');
            }
            else if ($(this).attr('datastatus') == '@((int)TaskStatus.Delay)')
            {
                $(".titledynamic").html('> متأخرة');
            }
            else if ($(this).attr('datastatus') == 'Assign')
            {
                $(".titledynamic").html('> غير مسندة');
            }
            // alert($(this).attr('datastatus'));

            // To Set bIsArchived Parameter Null .
            $('#bIsArchived').val('');
            $('#bIsNotAssigned').val('');
            $("#SearchDiv").show();
            $("#ReportsDiv").hide();

            if ($(this).attr('id') == 'more-tasks')
                $(this).addClass('active-tab');

            else {
                $(".more-tasks li a").css('background-color', '');
                $(".more-tasks li a").css('color','');
                if ($(this).attr('tab') == 'Report') {

                    $('#SearchDiv').hide();
                    $('#ReportsDiv').show();

                } else {

                    // To Click Show All Button Set Hidden Field With Status .
                    $('#iStatus').val($(this).attr('datastatus'));

                    if ($(this).attr('datastatus') == 'Assign') {
                        $('#bIsNotAssigned').val(true);
                        $('#iStatus').val('0');

                    }

                    if ($(this).attr('datastatus') == 'Archive') {
                        $('#bIsArchived').val(true);
                        $('#iStatus').val('0');

                    }

                    //  $('#btnShowAll').click();
                }
            }
        });

        $(function(){
            debugger;
            $(".dactive-tab > a").each(function () {
                debugger;
                $(this).addClass("maintab");
            })


        })
        $('.maintab').live('click', function() {
            debugger
            if($(".titledynamic").html() != "  ")
                $(".titledynamic").html("");

        });

        $('.more-tasks li a').click(function() {
            $('.more-tasks li a').removeClass('active-tab');
            $(this).addClass('active-tab');
            $("#SearchDiv").show();
            $("#ReportsDiv").hide();
        });

        $('#btnShowAll').click(function() {
            debugger;
            //$('#EmpID').val(0);
            //$('#strTitle').val('');
            //$('.errorMsg').hide();
            //$("#fromstartdate").val('');
            //$("#tostartdate").val('');
            //$("#fromenddate").val('');
            //$("#toendtdate").val('');
            ////$('.custom-bar .progress-bar').css('width', '0px');
            //$('.Priorbtns label:has(input:radio:(:checked))').removeClass('active')
            //$('#PriorityID').val(0);
            //$('.errorMsgEndDate').hide();
            //$('.errorMsgStartDate').hide();
            //$('#ProjectID').val(0);
            window.location.href = "/Company/Company/index";
        });

        // Override form submit to include EmpIDs as hidden field
        $('#SearchForm').on('submit', function () {
            // Remove any previously added hidden EmpID fields
            $(this).find('input[name="EmpIDs"]').not('#EmpIDs').remove();
        });

        //add validation rule to search name
        $('#strTitle').rules("add", { regex:  "@ValidationResource.RevString150" });

        $('#btnSearch').click(function(e) {
            debugger
            // Remove Validation If Valid .
            if (!$('#strTitle').valid() && $('#strTitle').val() != "")
                $('.errorMsg').show();
            else
                $('.errorMsg').hide();

            // Check Start Date .
            var sDate = $('input[type=text]#fromstartdate').val();
            var eDate = $('input[type=text]#tostartdate').val();

            if (sDate !== "" && eDate !== "") {
                if (dateCompare(sDate, eDate) == -1 || dateCompare(sDate, eDate) == 0) {
                    $('.errorMsgStartDate').hide();
                } else {
                    e.preventDefault();
                    $('.errorMsgStartDate').show();
                }
            }

            // Check End Date .
            var sEndDate = $('input[type=text]#fromenddate').val();
            var eEndDate = $('input[type=text]#toendtdate').val();

            if (sEndDate !== "" && eEndDate !== "") {
                if (dateCompare(sEndDate, eEndDate) == -1 || dateCompare(sEndDate, eEndDate) == 0) {
                    $('.errorMsgEndDate').hide();
                } else {
                    e.preventDefault();
                    $('.errorMsgEndDate').show();
                }
            }

            // $('#SearchForm').submit();

            //  return false;



        });

        //$(document).on('click','.strenth-bar',function(e) {
        //    alert("hiiiiiii")
        //})

        // Change Color Of Priority and Change PriorityID in DB .
    //    $(document).live('click','.strenth-bar',function(e) {
    //alert("hiiiiiii")
    //    })
        $( ".Priorbtns label").click(function() {
            debugger
            //alert("Priorbtns")
            $('#PriorityID').val(this.id);

            console.log(this.id);


        });

        $( ".priortybar label").click(function() {
            debugger
            //alert("priortybar")
            if (!$(this).hasClass('Static-bar')) {
                var priortyID = $(this).attr('id');
                var taskID = $(this).parent().attr('taskid')
                $('#loadding').fadeIn();

                $.ajax({
                    url: "/Company/Company/ChangePriority",
                    data: {
                        TaskID: taskID,
                        PriorityID: priortyID
                    },
                    type: 'POST',
                    complete: function(data) {

                        if (data.responseText.toLowerCase() == "false") {
                            Notify("danger", "حدث خطا لم يتم تغير الاولوية", 3000);
                            $(obj).css('width', OldWidth + "%");
                        }

                    }
                });

            }

        });



        $('.strenth-bar').live('click', function(e) {
            debugger
            // For Dimed Bar For Archived and Done Tasks .
            if (!$(this).hasClass('Static-bar')) {
                var leftPiont = (((e.pageX - $(this).offset().left) - 300) / 300 * -100);
                var obj = $(this).children('.progress-bar');
                    //.children('.progress-bar');

                $(this).removeAttr('title');

                var OldWidth = $(this).children('.progress-bar').width() / 300 * 100;

                var iPriorityID;
                debugger
                if (parseInt(leftPiont) >= 0 && parseInt(leftPiont) <= 25) {
                    $('.strenth-bar').append("<div class='progress-bar progress-bar-blue' role='progressbar' style='width:25%'>عادية </div>")
                    //$(obj).css('width', '25%').attr('title', 'عادية');
                    //$(obj).text('عادية');
                    //$(obj).attr('class','')
                    //$(obj).addClass('progress-bar-blue')

                    iPriorityID = '@((int)TaskPriority.Noraml)';
                }

                if (parseInt(leftPiont) >= 25 && parseInt(leftPiont) <= 50) {

                    $('.strenth-bar').append("<div class='progress-bar progress-bar-success' role='progressbar' style='width:25%'>متوسطة </div>")

                    //$(obj).css('width', '50%').attr('title', 'متوسطة');
                    //$(obj).text('متوسطة');
                    //$(obj).attr('class','')
                  //  $(obj).addClass('progress-bar-success')

                    iPriorityID = '@((int)TaskPriority.Average)';
                }

                if (parseInt(leftPiont) >= 50 && parseInt(leftPiont) <= 75) {
                    $(obj).css('width', '75%').attr('title', 'مرتفعة');
                    $(obj).addClass('progress-bar-warning')
                    iPriorityID = '@((int)TaskPriority.High)';
                }

                if (parseInt(leftPiont) >= 75 && parseInt(leftPiont) <= 100) {
                    $(obj).css('width', '100%').attr('title', 'مرتفعة جدا');
                    $(obj).addClass('progress-bar-danger')
                    iPriorityID = '@((int)TaskPriority.VeryHigh)';
                }

                $('#PriorityID').val(iPriorityID);

                // For Search Tasks By Priority .
                if (!$(this).hasClass('custom-bar')) {

                    $('#loadding').fadeIn();

                    $.ajax({
                        url: "/Company/Company/ChangePriority",
                        data: {
                            TaskID: $(this).attr('TaskID'),
                            PriorityID: iPriorityID
                        },
                        type: 'POST',
                        complete: function(data) {

                            if (data.responseText.toLowerCase() == "false") {
                                Notify("danger", "حدث خطا لم يتم تغير الاولوية", 3000);
                                $(obj).css('width', OldWidth + "%");
                            }

                        }
                    });
                }


            }
        });
        $(".tab").live('click', function(e) {
            debugger
            $('#strTitle').val('');
            $('#EmpIDs').val('').trigger('chosen:updated');
            $("#fromstartdate").val();
            $("#tostartdate").val();
            $("#fromenddate").val();
            $("#toendtdate").val();
            $('#PriorityID').val(0);
            $('#ProjectID').val(0);
            // Hide bulk delete bar when switching tabs
            $('#bulkActionsBar').hide();
        });
    });

    // To Get Position Of Clicked Area To Change Priority Slider .
    function findPosX(obj) {
        var curleft = 0;
        if (obj.offsetParent) {
            while (obj.offsetParent) {
                curleft += obj.offsetLeft;
                obj = obj.offsetParent;
            }
        } else if (obj.x) {
            curleft += obj.x;
        }
        return curleft;
    }
    $('.copy_text').click(function (e) {
        e.preventDefault();
        var copyText = $(this).attr('href');

        document.addEventListener('copy', function (e) {
            e.clipboardData.setData('text/plain', copyText);
            e.preventDefault();
        }, true);

        document.execCommand('copy');
        console.log('copied text : ', copyText);

    });

    // ==================== Bulk Delete Functions ====================
    function updateBulkBar() {
        var checked = $('#divTasks .chkTask:checked');
        var count = checked.length;
        if (count > 0) {
            $('#bulkActionsBar').show();
            $('#selectedCount').text(count + ' مهمة محددة');
        } else {
            $('#bulkActionsBar').hide();
        }
    }

    // Select All checkbox
    $(document).on('change', '#chkSelectAll', function () {
        var isChecked = $(this).is(':checked');
        $('#divTasks .chkTask').prop('checked', isChecked);
        updateBulkBar();
    });

    // Individual checkbox
    $(document).on('change', '.chkTask', function () {
        var total = $('#divTasks .chkTask').length;
        var checked = $('#divTasks .chkTask:checked').length;
        $('#chkSelectAll').prop('checked', total === checked && total > 0);
        updateBulkBar();
    });

    // Clear selection
    $(document).on('click', '#btnClearSelection', function () {
        $('#divTasks .chkTask').prop('checked', false);
        $('#chkSelectAll').prop('checked', false);
        updateBulkBar();
    });

    // Bulk Delete button
    $(document).on('click', '#btnBulkDelete', function () {
        var selectedIds = [];
        $('#divTasks .chkTask:checked').each(function () {
            selectedIds.push(parseInt($(this).val()));
        });

        if (selectedIds.length === 0) {
            Notify("warning", "الرجاء تحديد مهمة واحدة على الأقل", 3000);
            return;
        }

        if (selectedIds.length > 500) {
            Notify("warning", "الحد الأقصى للحذف 500 مهمة", 3000);
            return;
        }

        var bulkDeleteConfirmation = new Modal({
            title: 'تأكيد الحذف',
            message: 'هل أنت متأكد من حذف ' + selectedIds.length + ' مهمة؟<br><small class="text-muted">سيتم حذف المهام الجديدة فقط</small>',
            type: 'confirm',
            onAccept: function () {
                $('#loadding').fadeIn();
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("BulkDelete", "Company")',
                    data: JSON.stringify({ taskIds: selectedIds }),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    success: function (data) {
                        $('#loadding').fadeOut();
                        if (data.error) {
                            Notify("danger", data.error, 4000);
                        } else {
                            var msg = 'تم حذف ' + data.successCount + ' مهمة بنجاح';
                            if (data.failCount > 0) msg += '، فشل حذف ' + data.failCount;
                            if (data.skippedNotNew > 0) msg += '، تم تجاوز ' + data.skippedNotNew + ' (ليست جديدة)';
                            Notify(data.successCount > 0 ? "success" : "warning", msg, 5000);
                            $('#chkSelectAll').prop('checked', false);
                            updateBulkBar();
                            $("#btnSearch").click();
                        }
                    },
                    error: function () {
                        $('#loadding').fadeOut();
                        Notify("danger", "حدث خطأ أثناء الحذف", 3000);
                    }
                });
                bulkDeleteConfirmation.hide();
            },
            onCancel: function () {
                bulkDeleteConfirmation.hide();
            }
        });
        bulkDeleteConfirmation.show();
    });

    // Reset checkboxes when grid reloads (AJAX update)
    $(document).ajaxComplete(function (event, xhr, settings) {
        if (settings.url && settings.url.indexOf('GetTasks') > -1) {
            updateBulkBar();
        }
    });
    // ==================== End Bulk Delete Functions ====================

