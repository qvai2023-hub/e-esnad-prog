                                            @Html.DropDownList("ProjectID", ViewBag.Project as SelectList, "الكل",
                                               new
                                               {
                                                   @id = "ProjectID",
                                                   Class = "form-control",
                                               })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group col-sm-6">

                                        <label class="col-sm-4 control-label"> تاريخ بداية من: </label>
                                        <div class="col-sm-8">
                                            <div class='input-group date'>
                                                @*@Html.TextBox("fromDate", null, new { @id = "fromstartdate", @class = "form-control" })*@
                                                <input type="text" id="fromstartdate" name="FromStartDate" class="form-control" readonly />
