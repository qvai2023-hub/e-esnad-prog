@using EtaskMinstry
@using EtaskMinstry.Models.Company
@using Resources


@{
    ViewBag.Title = "إدارة المهام";
    //Layout = "~/Views/Shared/_LayoutNoSearch.cshtml";
}
@*<div class="panel panel-default">*@

    <div class="clear">
    </div>


    @* --------------------------------------Start Nav Taps Menu ------------------------------------------- *@

    <ul class="nav nav-tabs" id="navTabs">



        @foreach (TaskStatus state in (TaskStatus[])Enum.GetValues(typeof(TaskStatus)))
            {
            <li>
                @Ajax.ActionLink(System.Configuration.ConfigurationManager.AppSettings[state.ToString()],
                             "GetTasks",
                             new { iStatus = (int)state },
                             new AjaxOptions
                             {
                                 UpdateTargetId = "divTasks",
                                 InsertionMode = InsertionMode.Replace,
                                 LoadingElementId = "loadding",
                                 LoadingElementDuration = 10,
                                 HttpMethod = "Get"
                             }, new
                             {
                                 @class = "tab",
                                 @dataStatus = (int)state,
                                 // @style = (state == TaskStatus.All || state == TaskStatus.Delay) ? "width:25px" : ""
                             })
            </li>
            }
        <li>
            @Ajax.ActionLink(System.Configuration.ConfigurationManager.AppSettings["Archive"], "GetTasks",
                         new { bIsArchived = true },
                         new AjaxOptions
                         {
                             UpdateTargetId = "divTasks",
                             InsertionMode = InsertionMode.Replace,
                             LoadingElementId = "loadding",
                             LoadingElementDuration = 10,
                             HttpMethod = "Get"
                         }, new
                         {
                             @class = "tab dactive-tab",
                             @dataStatus = "Archive",

                         })
        </li>
        <li>
            @Ajax.ActionLink(System.Configuration.ConfigurationManager.AppSettings["NotAssigned"], "GetTasks",
                         new
                         {
                             bIsNotAssigned = true,
                             iStatus = 0
                         },
                         new AjaxOptions
                         {
                             UpdateTargetId = "divTasks",
                             InsertionMode = InsertionMode.Replace,
                             LoadingElementId = "loadding",
                             LoadingElementDuration = 10,
                             HttpMethod = "Get"
                         }, new
                         {
                             @class = "tab dactive-tab subtab",
                             @dataStatus = "Assign"
                         })
        </li>
        <li class="dropdown">
            <a href="#" tab="1" class="tab dactive-tab" id="more-tasks" data-toggle="dropdown">
                <i class="icon-point-up"></i>أخرى
                <b class="caret"></b>
                 
            </a>
            <ul class="dropdown-menu icons-left dropdown-menu-left more-tasks" role="menu" aria-labelledby="more-tasks"></ul>
        </li>
        <span class="pull-right">
        <a href="/Company/Task/SaveData" class="btn btn-xs btn-success">إضافة مهمة 
            <i class="fa fa-plus"></i></a>
        </span>
    </ul>
    @* --------------------------------------End Nav Taps Menu --------------------------------------------- *@
    @*<div class="tab-content">
        <div class="tab-container tab-container2">*@

<div class="tabbable page-tabs">

    @* --------------------  Start Partial Table Return With Result------- *@
