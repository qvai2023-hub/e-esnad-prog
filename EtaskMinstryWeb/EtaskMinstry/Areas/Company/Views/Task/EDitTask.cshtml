        // Save Task .
        $("#btnSave").click(function () {
            debugger;
            //$("#SaveData").attr("disabled", "disabled");
            var submit = false;
            if ($("#Titletext").val() == "") {
                $("#TitleValidation").text("يجب ان لا تترك الخانات فارغة");
                $("#Titletext").addClass("input-validation-error");
            }

            $("#dateError").hide();

            $("#errorUploadFile").hide();

            $('#ExpectedTimeError').hide();

            $("#FilesDescription").val("");

            if ($("#EmpID").val() != ""
                && (
                    $("#dtStartDate").val() == ''
                        || $("#dtEndDate").val() == '')) {

                $("#dateError").html(" يجب تحديد تاريخ البداية و النهاية").show();
                return false;
            }

            // Add File Description Into Hidden Field .
            for (var i = 0; i < $(".Description").length; i++) {
                $("#FilesDescription").val($("#FilesDescription").val() + "," + $(".Description").eq(i).html());
            }


            $.ajax({
                type: "POST",
                url: "/Task/CheckDate",
                async: false,
                data: {
                    "dtStartDate": $('#dtStartDate').val(),
                    "dtEndDate": $('#dtEndDate').val()
                },
                success: function (data) {

                    if (data != "valid")
                        $('#dateError').html(data).show();

                    else if ($('#dtStartDate').val() != '' && $('#dtEndDate').val() != '' && $('#TimeExpectedID').val() != '' && $('#TimeUnitID').val() != '') {
                        $.ajax({
                            type: "POST",
                            url: "/Task/DateDifference",
                            async: false,
                            data: {
                                "dtStartDate": $('#dtStartDate').val(),
                                "dtEndDate": $('#dtEndDate').val(),
                                "iTimeCount": $('#TimeExpectedID').val(),
                                "iTimeUnit": $('#TimeUnitID').find(":selected").attr("value")
                            },
                            success: function (sdata) {

                                if (sdata.toLowerCase() == "false") {

                                    $('#ExpectedTimeError').html('الوقت المقدر أكبر من الوقت المتاح').show();
                                }
                                else {

                                    submit = true;
                                }
                            },
                            complete: function (data) {

                                if ($("#SaveData").valid() && submit) {
                                    $("#btnSave").attr("disabled", "disabled");
                                    $("#SaveData").submit();
                                    //$('form#id').submit(function () {
                                    //    $(this).find('input[type=submit]').attr('disabled', 'disabled');
                                    //});
                                }
                            }
                        });
                    }
                    else {
                        submit = true;
                    }
                },
                complete: function (data) {

                    if ($("#SaveData").valid() && submit) {
                        $("#btnSave").attr("disabled", "disabled");
                        //$(this).attr("disabled", "disabled");
                        $("#SaveData").submit();
                    }
                }
            });
            //if ($("#SaveData").valid() && submit) {
            //    $(this).attr("disabled", "disabled");
            //    $("#SaveData").submit();
