@using EtaskMinstry
@model  EtaskMinstry.Models.Task.TaskAddEdit
@{
    ViewBag.Title = "تعديل المهمه";
}



<script src='https://www.google.com/recaptcha/api.js'></script>

<!-- Right labels -->
@using (Html.BeginForm("SaveTask", "Task", FormMethod.Post, new { id = "SaveData", enctype = "multipart/form-data", @class = "form-horizontal" }))
{


    @Html.ValidationSummary(true, "", new { @class = "ErrorMessage" })


    @Html.HiddenFor(model => model.TaskID)
    ///*-------------Panel Head---------------------- */
    <div class="panel panel-default">

        <div class="panel-body">
            @*عنوان المهمة*@
            <div class="form-group">
                <label class="col-sm-2 control-label text-right">عنوان المهمة:</label>
                <div class="col-sm-10">
                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control", @id = "Titletext" })
                    @Html.ValidationMessageFor(model => model.Title, null, new { Style = "color:red;", @id = "TitleValidation" })
                </div>
            </div>
            @if (EtaskMinstry.MvcApplication.userData.BriefTaskReport)
            {
                <div class="form-group">
                    <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.BriefTaskName):</label>
                    <div class="col-sm-10">
                        @Html.TextBoxFor(model => model.BriefTaskName, new { @class = "form-control", @id = "Titletext" })
                        @Html.ValidationMessageFor(model => model.BriefTaskName, null, new { Style = "color:red;", @id = "TitleValidation" })
                    </div>
                </div>
            }
            @*التاريخ*@
            <div class="form-group">
                @*تاريخ البدايه:*@
                <div class="col-sm-6">
                    <div class="row">
                        <label class="col-sm-4 control-label text-right">تاريخ البداية:</label>
                        <div class="col-sm-8">
                            <div class='input-group date'>
                                @Html.TextBoxFor(model => model.StartDate,
                            new
                            {
                                Class = "form-control",
                                id = "dtStartDate",
                                Readonly = "readonly"
                            })
                                <span class="input-group-addon">
                                    <span class="fa fa-calendar"></span>
                                </span>
                            </div>
                            <br />

                            @Html.ValidationMessageFor(model => model.StartDate, null, new { Style = "Color:red;" })
                        </div>

                    </div>
                </div>
                @*تاريخ النهاية:*@
                <div class="col-sm-6">
                    <div class="row">
                        <label class="col-sm-4 control-label text-right">تاريخ النهاية:</label>
                        <div class="col-sm-8">
                            <div class='input-group date'>
                                @Html.TextBoxFor(model => model.EndDate, new
                               {
                                   Class = "form-control",
                                   id = "dtEndDate",
                                   Readonly = "readonly"
                               })
                                <span class="input-group-addon">
                                    <span class="fa fa-calendar"></span>
                                </span>
                            </div>
                            <br />
                            @Html.ValidationMessageFor(model => model.EndDate, null, new { Style = "Color:red;" })
                        </div>
                        <span id="dateError" style="color: red; display: none;"></span>
                    </div>
                </div>
            </div>
            @*المشروع*@
            <div class="form-group">
                <label class="col-sm-2 control-label text-right">المشروع:</label>
                <div class="col-sm-4">
                    @Html.DropDownList("ProjectID", ViewBag.Project as SelectList, "اختر مشروع",
                                       new
                                       {
                                           @id = "ProjectID",
                                           Class = "form-control"
                                       })

                </div>
            </div>
            @*الوصف*@
            <div class="form-group">
                <label class="col-sm-2 control-label text-right">الوصف:</label>
                <div class="col-sm-10">
                    @Html.TextAreaFor(model => model.Description, new
                   {
                       @class = "form-control",
                       @cols = 5,
                       @rows = 3,
                       scroll = "no"
                   })
                    <br />
                    @Html.ValidationMessageFor(model => model.Description, null, new
                   {
                       Style = "Color:red;"
                   })
                </div>
            </div>
            @*إسناد المهمة*@
        <div class="form-group">
            <label class="col-sm-2 control-label text-right">إسناد المهمة لـ:</label>
            @if (Model.StatusID != (int)TaskStatus.Approved && !Model.IsArchived && Model.StatusID != (int)TaskStatus.Done && Model.StatusID != (int)TaskStatus.Inprogress)
            {
                <div class="col-sm-4">
                    @Html.DropDownList("EmpID", ViewBag.Employee as SelectList, "اختر موظف",
                                        new
                                        {
                                            @id = "EmpID",
                                            Class = "form-control"

                                             })
                </div>
            }
            else
            {
                <div class="col-sm-4">
                    @Html.DropDownList("EmpID", ViewBag.Employee as SelectList, "اختر موظف",
                                        new
                                        {
                                            @id = "EmpID",
                                            Class = "form-control",
                                            disabled = "true"
                                        })
                </div>
            }
        </div>
            @*//الأهمية*@
            <div class="form-group">
                <label class="col-sm-2 control-label text-right">الأهمية:</label>
                <div class="col-sm-4">
                    @Html.DropDownList("PriorityID", ViewBag.Priority as SelectList, "اختر الأهمية",
                                       new
                                       {
                                           @id = "PriorityID",
                                           Class = "form-control",
                                       })

                </div>
                <div class="col-sm-2">
                    @*<div class="periority-panel">
                    <span class="label label-danger">مرتفعة جدا</span>
                </div>
                <div class="strenth-bar">
                    <div class="strenth-colors" style="width: 0%;">
                    </div>
                </div>*@

                    @Html.ValidationMessageFor(model => model.PriorityID, null, new { Style = "Color:red;" })

                </div>
            </div>
            @*الوقت*@
            <div class="form-group">
                <label class="col-sm-2 control-label text-right">الوقت المقدر:</label>
                <div class="col-sm-2">
                    @Html.TextBoxFor(model => model.ExpectedTime, new
                   {
                       @id = "TimeExpectedID",
                       @class = "form-control",
                   })
                </div>
                <div class="col-sm-2">
                    @Html.DropDownList("TimeUnitID", ViewBag.TimeUnit as SelectList, "اختر الوحدة",
                                       new
                                       {
                                           @id = "TimeUnitID",
                                           Class = "form-control",
                                       })
                    <br />
                    @Html.ValidationMessageFor(model => model.ExpectedTime, null,
                    new
                    {
                        Style = "Color:red;",
                        @id = "ExpectedTimeValidation"
                    })
                </div>
                <span id="ExpectedTimeError" style="color: red; display: none;"></span>
            </div>

            @*المرفقات*@
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h6 class="panel-title">
                        <i class="fa fa-paperclip"></i> المرفقات
                    </h6>
                </div>
                <div class="panel-body">
                    <div class="form-bordered AttachedFiles">
                        <div class="form-group">
                            <label class="col-sm-2 control-label text-right">الملف:</label>
                            <div class="col-sm-10">
                                @*<input type="file" class="btn btn-success">*@


                                <input id="UploadFile" type="button" class="btn btn-primary" value="تحميل">
                                <br />
                                <input type="file" name="TaskFileUploader" style="display: none;" class="btn btn-success" id="TaskFileUploader">
                                <span id="fileName" style="display: none;"></span>
                                <input id="btnCancelFile" type="button" class="submit-btn" value="حذف" style="display: none">
                                <span id="errorUploadFile" style="display: none; color: red;" class="errorUploadFile">من فضلك اختر ملف</span>


                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label text-right">الوصف:</label>
                            <div class="col-sm-4">
                                <input type="text" name="txtFileDesc" id="txtFileDesc" class="form-control">
                                <br />
                                <span id="errorDescFile" style="display: none; color: red;">يجب ان لا يزيد عدد الحروف عن 350 حرف و غير مسموح بكتابه رموز خاصه .</span>
                            </div>
                        </div>

                        <div id="recap" style="display:none"><div class="g-recaptcha" data-sitekey="@System.Configuration.ConfigurationManager.AppSettings["RecaptchaSiteKey"]"></div></div>


                        @if (Model != null)
                        {
                            String strFileDesc = "filedesc";
                            int FileCount = 0;
                            if (Model.Attachment != null)
                            {
                                foreach (TaskManagementModel.Attachment attachment in Model.Attachment)
                                {
                                    FileCount++;
                                    @*<div class="form-group">
                                    <div class="col-sm-10">
                                        <div class="row">
                                            <label class="col-sm-2 control-label text-right">الملف:</label>
                                            <a href="~/Upload/Task/@attachment.FileName">@attachment.FileName</a>
                                            <a href="javascript:void(0);" class="Delete-icon deleteFile NewFile" title="حذف" style="float:left;"></a>
                                        </div>
                                        <div class="row">
                                            <label class="col-sm-2 control-label text-right">
                                                <span id='@strFileDesc@FileCount'>@attachment.Description</span>

                                            </label>
                                        </div>
                                    </div>
                                </div>*@
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label text-right">الملف:</label>
                                        <div class="col-sm-6">
                                            <a href="~/Upload/Task/@attachment.FileName" style="font-size:15px;" target="_blank">@(attachment.OriginalFileName ?? attachment.FileName)</a>
                                        </div>
                                        <div class="col-sm-2">
                                            <a href="javascript:void(0);" class="Delete-icon deleteFile NewFile" title="حذف" style="float:left;" id="@attachment.AttachmentID"></a>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label text-right">الوصف:</label>
                                        <div class="col-sm-6">
                                            <div id='@strFileDesc@FileCount' class="Description"> @attachment.Description </div>
                                        </div>
                                    </div>


                                }
                            }
                        }

                    </div>
                </div>
            </div>

            @*حفظ*@
            <div class="form-actions text-right">
                <input type="button" value="حفظ" id="btnSave" class="btn btn-primary">&nbsp;
                <a href="/company/" value="إلغاء" class="btn btn-default">الغاء</a>

            </div>

        </div>
    </div>


    <input type="hidden" id="FilesDescription" name="FilesDescription" />
    <input type="hidden" id="RemovedFiles" name="RemovedFiles" />

}
