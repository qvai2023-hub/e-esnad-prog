@model EtaskMinstry.Models.EmployeeTask.EmployeeTaskListVM
@using EtaskMinstry;
@using EtaskMinstry.Models.Status;
@using EtaskMinstry.CustomHelpers;
@{
    ViewBag.Title = " إدارة المهام";
    Layout = "~/Views/Shared/_LayoutNoSearch.cshtml";
    //Layout = "~/Views/Shared/_LayoutNoSearchOld.cshtml";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}




<ul class="nav nav-tabs">
    <li class="active">
        @Ajax.RawActionLink("<i class='fa fa-tasks'></i> الكل", "GetTasks", null, new { status = 0 },
    new AjaxOptions
    {
        UpdateTargetId = "divTasks",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loadding",
        LoadingElementDuration = 10,
        HttpMethod = "Get"
    }, new { @class = "tab dactive-tab" + "", @dataStatus = 0, onclick = "UpdateHeader('كل المهام')" })
    </li>
    @foreach (StatusDisplay TaskStatus in ViewBag.status)
    {
        <li>
            @if (TaskStatus.Name != "مرفوضة" && TaskStatus.Name != "مقبولة")
            {
                @Ajax.RawActionLink(String.Concat("<i class='", TaskStatus.DesignClass, "'></i>", TaskStatus.Name, (TaskStatus.Name == "جديدة") ? "<span class='label label-success'>" + (string)ViewBag.NewCount + "</span>" : (TaskStatus.Name == "انتهت") ? "<span class='label label-success'>" + (string)ViewBag.EndedCount + "</span>" : ""), "GetTasks", null, new { status = TaskStatus.ID },
                new AjaxOptions
                {
                    UpdateTargetId = "divTasks",
                    InsertionMode = InsertionMode.Replace,
                    LoadingElementId = "loadding",
                    LoadingElementDuration = 10,
                    HttpMethod = "Get"
                }, new { @class = "tab dactive-tab", @dataStatus = TaskStatus.ID, onclick = "UpdateHeader('" + TaskStatus.Name + "," + TaskStatus.Count + "')" })
            }
        </li>
    }
</ul>


<div class="tab-content">
    <!-- Tasks table -->
    <div class="panel panel-default">
        <div class="panel-heading">
            <h6 class="panel-title"><i class="fa fa-tasks"></i> <span id="tableheader">كل المهام </span></h6>
            <span id="listcount" class="pull-right label label-danger">@ViewBag.count</span>
        </div>
        <div class="panel-body">
            <div class="panel-group">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h6 class="panel-title panel-trigger">
                            <a data-toggle="collapse" href="#panel-search">بحث</a>
                        </h6>
                    </div>
                    <div id="panel-search" class="panel-collapse collapse">
                        <div class="panel-body">

                            <!--tab content-->
                            @using (Ajax.BeginForm("GetTasks", "Tasks", new AjaxOptions
                            {
                                InsertionMode = InsertionMode.Replace,
                                UpdateTargetId = "divTasks",
                                LoadingElementId = "loadding",
                                LoadingElementDuration = 30
                            }, new { area = "Employee", id = "SearchForm" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    @Html.Hidden("priorityId")
                                    @Html.Hidden("status")
                                    <div class="form-group col-sm-6">
                                        <label class="col-sm-4 control-label">عنوان المهمة: </label>
                                        <div class="col-sm-8">
                                            @Html.TextBox("taskTitle", "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="form-group col-sm-6">
                                        <label class="col-sm-4 control-label">الأهمية: </label>
                                        <div class="col-sm-8">


                                            <div class="Priorbtns btn-group" data-toggle="buttons">
                                                <label class="btn btn-xs btn-info" id="1">
                                                    <input type="radio" name="options"> عادية
                                                </label>
                                                <label class="btn btn-xs btn-success" id="2">
                                                    <input type="radio" name="options"> متوسطة
                                                </label>
                                                <label class="btn btn-xs btn-warning" id="3">
                                                    <input type="radio" name="options"> مرتفعة
                                                </label>
                                                <label class="btn btn-xs btn-danger" id="4">
                                                    <input type="radio" name="options"> مرتفعة جدا
                                                </label>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group col-sm-6">

                                        <label class="col-sm-4 control-label">تاريخ البداية من: </label>
                                        <div class="col-sm-8">
                                            <div class='input-group date'>
                                                @Html.TextBox("fDate", "", new { @class = "form-control", @style = "margin-left:47px;", @readonly = "true" })
                                                <span class="input-group-addon">
                                                    <span class="fa fa-calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                        <p class="errorMsgDate" style="display: none; color: red; margin-right: 85px; margin-top: 5px">
                                            يجب ان يكون تاريخ النهاية اكبر من تاريخ البداية
                                        </p>
                                    </div>
                                    <div class="form-group col-sm-6">

                                        <label class="col-sm-4 control-label">إلى: </label>
                                        <div class="col-sm-8">
                                            <div class='input-group date'>
                                                @Html.TextBox("tDate", "", new { @class = "form-control", @readonly = "true" })
                                                <span class="input-group-addon">
                                                    <span class="fa fa-calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                        <p class="errorMsgEndDate" style="display: none; color: red; margin-right: 85px; margin-top: 5px">
                                            يجب ان يكون تاريخ النهاية اكبر من تاريخ البداية
                                        </p>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group col-sm-6">

                                        <label class="col-sm-4 control-label">تاريخ النهاية من: </label>

                                        <div class="col-sm-8">
                                            <div class='input-group date'>
                                                <input readonly type="text" id="fromenddate" name="FromEndDate" class="form-control" style="margin-left:47px;" />
                                                <span class="input-group-addon">
                                                    <span class="fa fa-calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-sm-6">

                                        <label class="col-sm-4 control-label">إلى: </label>
                                        <div class="col-sm-8">
                                            <div class='input-group date'>
                                                <input readonly type="text" id="toendtdate" name="ToEndDate" class="form-control" />
                                                <span class="input-group-addon">
                                                    <span class="fa fa-calendar"></span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <input name="Submit0" id="btnSearch" type="submit" class="btn btn-primary" value="بحث">
                                    <input name="Submit0" id="btnShowAll" type="submit" class="btn btn-primary" value="عرض الكل">


                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="divTasks">
            @*@Html.Action("GetTasks", "Tasks")*@
            @{ Html.RenderPartial("PartialEmpTask", (EtaskMinstry.Models.EmployeeTask.EmployeeTaskListVM)ViewData["SearchResult"]); }

        </div>
    </div>
    <!-- /tasks table -->
    <!--tab content end-->

</div>

<style>
    .form-select {
        width: 150px;
    }

    .form-textbox {
        width: 160px;
    }
</style>
<script src="~/Scripts/ui/ui.datepicker.js"></script>
