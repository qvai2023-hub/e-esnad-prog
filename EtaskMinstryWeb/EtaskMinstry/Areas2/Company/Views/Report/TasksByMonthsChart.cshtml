@using EtaskMinstry

@model EtaskMinstry.Areas.Company.Models.YearlyTasksChart
@{
    ViewBag.Title = "إحصائيات المهام السنوية";
    Layout = "~/Views/Shared/_LayoutNoSearch.cshtml";
}

<script>
    $(function () {
        var chart;
        $(document).ready(function () {

            if ($('#EmpID option:selected').text() != "الكل")
                $('#chartEmployee').text("اسم الموظف: " + $('#EmpID option:selected').text())
            else
                $('#chartEmployee').text("")

            if ($('#ddlHijriDateYear option:selected').text() != "الكل")
                $('#chartYear').text("السنة:" + $('#ddlHijriDateYear option:selected').text())
            else
                $('#chartYear').text("")



            chart = new Highcharts.Chart({
                chart: {
                    renderTo: 'container',
                    type: 'column',
                    events: {
                        load: function (event) {

                            $("tspan").each(function () {
                                if ($(this)[0].textContent == "Highcharts.com")
                                    $(this).remove();
                            });
                        }
                    }
                },
                title: {
                    text: "<div >"  + $('#chartEmployee').text() + " " + $('#chartYear').text() + "</div>"

                },
                subtitle: {
                    text: ''
                },
                xAxis: {
                    categories: [
                        'محرم',
                        'صفر',
                        'ربيع أول',
                        'ربيع آخر',
                        'جماد أول',
                        'جماد آخر',
                        'رجب',
                        'شعبان',
                        'رمضان',
                        'شوال',
                        'ذو القعدة',
                        'ذو الحجة'
                    ],
                    labels: {
                        rotation: -20,
                        style: {


                        },

                        y: 25
                    }
                },
                yAxis: {
                    min: 0,
                    title: {
                        text: 'عدد المهام'
                    }
                },
                legend: {
                    layout: 'vertical',
                    backgroundColor: '#FFFFFF',
                    align: 'right',
                    verticalAlign: 'top',
                    x: -30,
                    y: -10,
                    width:130,
                    floating: true,
                    shadow: true
                },
                tooltip: {
                    formatter: function() {
                        return '' + this.x + ': ' + this.y + " مهمة";
                    }
                },
                plotOptions: {
                    column: {
                        pointPadding: 0,
                        borderWidth: 0
                    }
                },
                series: [{
                    name: 'المهام المنشئة',
                    data: [@Model.CreatedTasks]
                },
                {
                    name: 'المهام معتمدة',
                    data: [@Model.ApprovedTasks]
                },
                {
                    name: 'المهام الغير معتمدة',
                    data: [@Model.RefusedTasks]
                },
                {
                    name: 'المهام المنتهية',
                    data: [@Model.DoneTasks]
                }],
                exporting: {
                    buttons: {
                        contextButton: {
                            menuItems: [{
                                text: 'تحميل صورة',
                                onclick: function () {
                                    this.exportChart();
                                }
                            }, {
                                text: 'PDF تحميل ',
                                onclick: function () {
                                    this.exportChart({
                                        type: 'application/pdf'
                                    });
                                },
                                separator: false
                            }]
                        }
                    }
                }
                
            });
        });
    });
   
</script>
@using (Html.BeginForm("TasksByMonthsChart", "Report"))
{
    
      <div class="panel panel-info">
                          <div class="panel-heading">
                            <h6 class="panel-title panel-trigger">
                              <a data-toggle="collapse" href="#panel-search" class="collapsed">بحث</a>
                              </h6>
                            </div>
                          <div id="panel-search" class="panel-collapse collapse" style="height: 0px;">
                            <div class="panel-body">
                                <div class="row">
                                    <div class="form-group">
                                        <label class=" col-sm-2">إسم الموظف : </label>
                                        <div class="col-sm-3">
                                            @Html.DropDownList("EmpID", ViewBag.Employees as SelectList, "الكل",
                       new
                           {
                               @id = "EmpID",
                               Class = "form-control"
                           })
                                        </div>



                                    </div>


                                </div>
                                <br />
                                <div class="row">
                                    <div class="form-group">
                                        <label class=" col-sm-2">السنة: </label>
                                        <div class="col-sm-4">
                                            @Html.DropDownList("ddlHijriDateYear", Model.Years, null,
                                               new
                                                   {
                                                       @id = "ddlHijriDateYear",
                                                       Class = "form-control",
                                                   })


                                        </div>
                                    </div>
                                </div>


                                  <div class="text-right">
                                      <input id="btnShowChart" type="submit" value="عرض" class="btn btn-primary" />
                                  </div>
                             
                              </div>
                            </div>
                      </div>
  
       <h6 id="chartEmployee"></h6>
      <h6 id="chartYear"></h6>
    <div id="container" style="min-width: 400px; height: 600px; margin: 0 auto; direction: ltr;margin-top: 40px;">"></div>
}