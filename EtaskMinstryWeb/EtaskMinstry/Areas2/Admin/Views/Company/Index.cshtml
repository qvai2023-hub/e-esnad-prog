        applyClassesToWebGrid();

    </script>
<script>
        $('#searchBtn').click(function()
        {
           // alert('clickk')
            var name = $("#Name").val();
            var email = $("#Email").val();
            var commercialRegister = $("#CommercialRegister").val();

            $.ajax({
                type: 'Post',
                url: '@Url.Action("Index")',
                dataType: 'html',
                data: { "Name": name, "Email": email, "CommercialRegister": commercialRegister },
                success: function (data) {
                    $("body").html(data);
                    console.log(data)
                }
            });
        });

        function Search() {
            debugger
            console.log('Search function')
        var name = $("#Name").val();
        var email = $("#Email").val();
        var commercialRegister = $("#CommercialRegister").val();
        if (ValidateRegExp($("#Name")) && ValidateRegExp($("#CommercialRegister")) && ValidateEmail($("#Email"))) {
            $.ajax({
                type: 'Post',
                url: '@Url.Action("Index")',
                dataType: 'html',
                data: { "Name": name, "Email": email, "CommercialRegister": commercialRegister },
                success: function (data) {
                    $("#list").html(data);
                    console.log(data)
                }
            });
        }
    }

    function Clear() {
        $("#Name").val("").css("background-color", "#fff");
        $("#Email").val("").css("background-color", "#fff");
        $("#CommercialRegister").val("").css("background-color", "#fff");
    }

    function ValidateRegExp(searchString){
        var regx = "^[a-zA-Z0-9\u0600-\u06ff,./\s _-]{0,350}$";
        var match = ($(searchString).val()).match(regx);
        if (match == null) {
            $(searchString).css("background-color", "#ffeeee")
            return false;
        } else {
            $(searchString).css("background-color", "#fff")
            return true;
        }
    }

    function ValidateEmail(email) {
        var re = /^(([^<>()[\]\\.,;:\s@@\"]+(\.[^<>()[\]\\.,;:\s@@\"]+)*)|(\".+\"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;

        if (re.test($(email).val()) || $(email).val() == "") {
            $(email).css("background-color", "#fff")
            return true;
        } else {
            $(email).css("background-color", "#ffeeee")
            return false;
        }

    }

</script>
