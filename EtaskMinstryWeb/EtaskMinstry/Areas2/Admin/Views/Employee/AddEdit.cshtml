                <div class="col-sm-10">
                    <div id="nationalImg">
                        @Html.Partial("PartialUploadImage", Model, new ViewDataDictionary { { "ProperyToBind", "NationaIDImage" } })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.LaborOfficeID):</label>
                <div class="col-sm-10">
