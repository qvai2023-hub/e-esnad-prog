                    Style = "Color:red;",
                    @id = "TitleValidation"
                })
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.Gender):</label>
                <div class="col-sm-10">
                    @Html.RadioButtonFor(model => model.Gender, true) ذكر
                    @Html.RadioButtonFor(model => model.Gender, false) أنثى
                    <br />
                    @Html.ValidationMessageFor(model => model.Gender, null,
                new
                {
                    Style = "Color:red;",
                    @id = "TitleValidation"
                })
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.JobTitle):</label>
                <div class="col-sm-10">
                    @Html.TextBoxFor(model => model.JobTitle, new { @class = "form-textbox" })
                    <br />
                    @Html.ValidationMessageFor(model => model.JobTitle, null,
                new
                {
                    Style = "Color:red;",
                    @id = "TitleValidation"
                })
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.Address):</label>
                <div class="col-sm-10">
                    @Html.TextBoxFor(model => model.Address, new { @class = "form-textbox" })
                    <br />
                    @Html.ValidationMessageFor(model => model.Address, null,
                new
                {
                    Style = "Color:red;",
                    @id = "TitleValidation"
                })
                </div>
            </div>
@if (Model == null && ViewBag.Message == null || Model != null && Model.Id == 0 && ViewBag.IsValiRecap == false)
{

    <div class="form-group">
        <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.Email):</label>
        <div class="col-sm-10">
            @Html.TextBoxFor(model => model.Email, new { @class = "form-textbox" })
            <br />
            @Html.ValidationMessageFor(model => model.Email, null,
                new
                {
                    Style = "Color:red;",
                    @id = "TitleValidation"
                })
        </div>
    </div>
}

            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.Mobile):</label>
                <div class="col-sm-10">
                    @Html.TextBoxFor(model => model.Mobile, new { @class = "form-textbox" })
                    <br />
                    @Html.ValidationMessageFor(model => model.Mobile, null,
                new
                {
                    Style = "Color:red;",
                    @id = "TitleValidation"
                })
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.IsActive):</label>
                <div class="col-sm-10">
                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-textbox" })
                    <br />
                    @Html.ValidationMessageFor(model => model.IsActive, null,
                    new
                    {
                        Style = "Color:red;",
                        @id = "TitleValidation"
                    })
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.Birthdate):</label>
              
                  <div class="col-sm-3">
                      <div class='input-group date'>
                          @Html.TextBoxFor(model => model.Birthdate, new {  @class = "form-control", @readonly = "readonly" })
                       
                            <span class="input-group-addon">
                              <span class="fa fa-calendar"></span>
                          </span>
                          </div>
                        
