                {
                    Style = "Color:red;",
                    @id = "TitleValidation"
                })
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.Name):</label>
                <div class="col-sm-10">
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-textbox" })
                    <br />
                    @Html.HiddenFor(model => model.Name, new { @name = "HF_Name" })

                    @Html.ValidationMessageFor(model => model.Name, null,
                new
