@if (ViewBag.Message != null)
{
    <script>

        $(document).ready(function () {
            var isValid = true;

            $('.field-validation-error').each(function (i, obj) {
                if ($(this).css('display') != 'none') {
                    isValid = false;
                    return false;
                }
            });
            if (isValid)//model is valid and it has been saved  truely
            {
                Modal.showMessage({ title: ' حفظ', message: 'تم حفظ العملية بنجاح', type: 'alert', onAccept: function () { window.location.href = "/Admin/Employee/AddEdit"; }, time: false });

            } else// model is not valid
            {
                Modal.hide();
            }

        });

    </script>
}
@if (ViewBag.IsValiRecap == false)
{
    <script>
        $(document).ready(function () {
            $("#RecaptchaValidation").show();
        });
    </script>
}
<script>
    //get web.config variables for _PartialUploadImage.js file
    var Extentions = "@System.Configuration.ConfigurationManager.AppSettings["ImageExtensions"]";
    var size = "@System.Configuration.ConfigurationManager.AppSettings["maxfileSize"]";

    $(document).ready(function () {
        //stop textboxes from autoComplete
        $("form :input").attr("autocomplete", "off");
    debugger
        // Add Calendar To TextBoxs .
        var Isgreg = "@(MvcApplication.IsGregDate)";
        if (Isgreg == "True") {
            //datepicker
            var fullmonth_array = $.datepicker.regional['ar'].monthNames
            $('#Birthdate').datepicker(
                {
                    changeMonth: true,
                    changeYear: true,
                    yearRange: '1920:2016',
                    monthNamesShort: fullmonth_array
                },
           $.datepicker.regional["ar"]);
            //
        } else {
            $('#Birthdate').calendarsPicker({
                changeMonth: true,
                changeYear: true,
                showTrigger: '#calImg',
                calendar: $.calendars.instance('ummalqura'),
                dateFormat: 'dd/mm/yyyy',
                yearRange: '1418:1450'
            });
        }
        //delete bithdate textbox value
        $('.iconbox .icon-trashA').live('click', function (e) {
            debugger;
            e.preventDefault();
            $("#Birthdate").val("");
        });
        //rehire employee
        $('#NationalID').change(function () {
            var iRehiredEmployeeId = 0;
            var reHireConfirmation = new Modal({
                title: 'إعادة توظيف', //title of the popup
                message: 'هذا الموظف تم مسحه من شركتكم سالفا. هل تريد إعادة توظيفه؟', // message text  notes: overrided if there're  id form
                type: 'confirm',  // type of the modal 'alert', 'confirm' or 'form'
                id: '',  // id of the form to show it on the modal
                onAccept: function () {
                    $.ajax({
                        type: 'Post',
                        url: '@Url.Action("RehireDeletedEmp")',
                        dataType: 'json',
                        data: { EmpId: iRehiredEmployeeId },
                        success: function (data) {
                            window.location.href = "/Admin/Employee/AddEdit?empid=" + iRehiredEmployeeId;
                        },
                        error: function (e) {
                        },
                        complete: function (data) {
                            if (data.responseText.toLowerCase() == "true") {
                                Notify("success", "تم إعادة التوظيف.يمكنك تعديل البيانات.", 3000);
                                $("#btnSearch").click();
                            } else
                                Notify("danger", "لم تتم إعادة التوظيف", 3000);
                        }
                    });

                    reHireConfirmation.hide();
                },// call back runs after modal accept,
                onCancel: function () {
                    reHireConfirmation.hide();
                } // call back runs after modal cancel default  is false , closes the modal.
            });
            reHireConfirmation.hide();

            var NationalId = $('#NationalID').val();

            if (NationalId.length >= 10) {
                $.ajax({
                    type: 'Post',
                    url: '@Url.Action("CheckDeletedEmpNationlID")',
                    dataType: 'json',
                    data: { "NationalID": NationalId },
                    success: function (response) {
                        response = JSON.stringify(response);
                        if (response > 0) {
                            iRehiredEmployeeId = response;
                            reHireConfirmation.show();
                        }
                        else {
                            iRehiredEmployeeId = 0;
                            reHireConfirmation.hide();
                        }
                    }
                });
            }

        })
    });
    //$("#Email").attr("disabled", "disabled");
    $("#CompanyID").change(function() {
        if ($("#CompanyID").val() != "") {

            $("#Email").removeAttr("disabled");
        } else {
            $("#Email").attr("disabled", "disabled");
        }
        debugger;
        if ($('#Name').val()!="") {
            $('#Name').removeData('previousValue');
            $('#AddEditEmpForm').validate().element('#Name');
        }

    })

</script>

