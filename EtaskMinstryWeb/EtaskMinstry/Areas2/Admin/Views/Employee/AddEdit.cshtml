<script src="~/Scripts/Employee/_PartialUploadImage.js"></script>
<script src='https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit' async defer></script>


@Html.ValidationSummary(true)
@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.EmpID)

<!-- Right labels -->
<form class="form-horizontal" method="post" role="form">
    <div class="panel panel-default">
        <div class="panel-heading"><h6 class="panel-title"><i class="fa fa-edit"></i> تعديل / اضافه </h6></div>
        <div class="panel-body">

            <div class="form-group">
                <label class="col-sm-2 control-label text-right">@Html.LabelFor(model => model.CompanyID):</label>
                <div class="col-sm-10">
                    @Html.DropDownList("CompanyID", ViewBag.Company as SelectList, "اختر...",
                    new
                    {
                        @id = "CompanyID",
                        Class = "form-select"
                    })
                    <br />
                    @Html.HiddenFor(model => model.CompanyID, new { @name = "HF_Company" })
                    @Html.ValidationMessageFor(model => model.CompanyID, null,
