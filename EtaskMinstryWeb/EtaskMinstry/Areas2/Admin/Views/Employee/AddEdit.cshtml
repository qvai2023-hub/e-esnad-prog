@using EtaskMinstry
@model EtaskMinstry.Areas.Admin.Models.CompanyEmployeeVM

@{
    ViewBag.Title = "اضافة / تعديل موظف";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Scripts/QVUploader/QVUploader.css" rel="stylesheet" />
