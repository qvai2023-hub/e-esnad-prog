@using EtaskMinstry
@model IEnumerable<EtaskMinstry.Models.Employee.DashBoardVM>
@if (Model.Any())
{
    <input type="hidden" value="@DateTime.Now.ToGregArabicDate().Trim()" id="todayDate" />

    <div id="list" class="table-responsive">
        <div>
            @{
    var grid = new WebGrid(Model, null, null, 10, true, true, "divTasks");
    var gridColumns = new List<WebGridColumn>();

    if (Model.All(i => i.IsDelayed == true))
    {
        gridColumns.Add(grid.Column("TaskName", "المهمة", @<text>@Html.EncodedActionLink((string)@item.taskName, "TaskDetails", "Tasks", "Employee", new { id = @item.TaskID, IsRoute = true }, null)</text>, "FirstColumn"));
        gridColumns.Add(grid.Column("Status", "الحالة", @<text>@item.Status</text>, "FirstColumn"));
        gridColumns.Add(grid.Column("StartDate", "تاريخ البداية", @<text>@item.HijriStartDate</text>, "SecondColumn"));
        gridColumns.Add(grid.Column("Endate", "تاريخ النهاية", @<text>@item.HijriEndDate </text>, "ThirdColumn"));

        gridColumns.Add(grid.Column("Delay", "التأخير", @<text>@item.delayTime</text>, "FourthColumn"));

        gridColumns.Add(grid.Column("Deliver", "انهاء", @<text>
            @if (item.statusId == (int)TaskStatus.Inprogress && item.actualTime != 0)
            {
                <a taskid="@item.taskID" href="javascript:void(0);" class="FinishTask" title="انهاء المهمة"><img src="/Content/Main/images/end-icon.png" width="16" height="16"></a>

            }
            else
            {
                <a taskid="@item.taskID" style="display:none;" href="javascript:void(0);" class="FinishTask" title="انهاء المهمة"><img src="/Content/Main/images/end-icon.png" width="16" height="16"></a>
            } </text>, "FourthColumn"));

    }
    else if (Model.All(i => i.statusId == (int)TaskStatus.New && i.EmpID == MvcApplication.userData.userId))
    {
        gridColumns.Add(grid.Column("TaskName", "المهمة", @<text>@Html.EncodedActionLink((string)@item.taskName, "TaskDetails", "Tasks", "Employee", new { id = @item.TaskID, IsRoute = true }, null)</text>, "FirstColumn"));
        gridColumns.Add(grid.Column("StartDate", "تاريخ البداية", @<text>@item.HijriStartDate</text>, "SecondColumn"));
        gridColumns.Add(grid.Column("Endate", "تاريخ النهاية", @<text>@item.HijriEndDate </text>, "ThirdColumn Endate"));
        gridColumns.Add(grid.Column("Accept", "قبول", @<text><a taskid="@item.taskID" href="javascript:void(0);" class="accepted-icon" title="قبول المهمة"><img src="/Content/Main/images/Check-icon.png" width="16" height="16" /></a>
        </text>, "FourthColumn"));
        gridColumns.Add(grid.Column("Refused", "رفض", @<text><a taskid="@item.taskID" href="javascript:void(0);" class="refused-icon" title="رفض المهمة"><img src="/Content/Main/images/delete-icon.png" width="16" height="16" /></a>
        </text>, "fivethColumn"));


    }//&& i.endDate.Value.Date !=DateTime.Now.Date
    else if (Model.All(i => i.statusId == (int)TaskStatus.Inprogress && !i.IsSusbended))
    {
        gridColumns.Add(grid.Column("TaskName", "المهمة", @<text>@Html.EncodedActionLink((string)@item.taskName, "TaskDetails", "Tasks", "Employee", new { id = @item.TaskID, IsRoute = true }, null)</text>, "FirstColumn"));
        gridColumns.Add(grid.Column("StartDate", "تاريخ البداية", @<text>@item.HijriStartDate</text>, "SecondColumn"));
        gridColumns.Add(grid.Column("Endate", "تاريخ النهاية", @<text>@item.HijriEndDate </text>, "Column Endate"));


        gridColumns.Add(grid.Column("TaskName", "الوقت المستغرق اليوم", @<text><div class="estimated-time">

                <span class="estm_time" style="display: inline-flex;">
                    <p class="actualTime" style="line-height: 1.5;padding-left: 6px;">@item.TasktodayTime</p>ساعة
                    <a time="3" class="edit-inline-icon modify_time" title="تعديل"><i style="line-height: 1.5;padding-right: 4px;" class="fa fa-edit"></i></a>
                </span>
                <span class="divTimeUpdate" style="display: none;">
                    <input type="text" class="time_value">
                    <img src="~/Content/Main/images/tick.png" taskid="@item.taskID" class="approved" style="position: relative; top: 3px; right: 4px;">
                </span>
            </div></text>, "ThirdColumn"));
        gridColumns.Add(grid.Column("Deliver", "انهاء", @<text>
                @if (item.actualTime != 0)
                {
                    <a taskid="@item.taskID" href="javascript:void(0);" class="FinishTask" title="انهاء المهمة"><img src="/Content/Main/images/end-icon.png" width="16" height="16"></a>

                }
                else
                {
                    <a taskid="@item.taskID" style="display:none;" href="javascript:void(0);" class="FinishTask" title="انهاء المهمة"><img src="/Content/Main/images/end-icon.png" width="16" height="16"></a>
                } </text>, "FourthColumn"));


    }
    else if (Model.All(i => i.statusId == (int)TaskStatus.Inprogress && (i.endDate >= DateTime.Now.AddDays(-1) && i.endDate <= DateTime.Now.AddDays(1))))
    {
        gridColumns.Add(grid.Column("TaskName", "المهمة", @<text>@Html.EncodedActionLink((string)@item.taskName, "TaskDetails", "Tasks", "Employee", new { id = @item.TaskID, IsRoute = true }, null)</text>, "FirstColumn"));
        gridColumns.Add(grid.Column("StartDate", "تاريخ البداية", @<text>@item.HijriStartDate</text>, "SecondColumn"));
        gridColumns.Add(grid.Column("Deliver", "انهاء", @<text><a taskid="@item.taskID" href="javascript:void(0);" class="FinishTask" title="انهاء المهمة"><img src="/Content/Main/images/end-icon.png" width="16" height="16"></a>
        </text>, "ThirdColumn"));
    }
    else
    {
        gridColumns.Add(grid.Column("TaskName", "المهمة", @<text>@Html.EncodedActionLink((string)@item.taskName, "TaskDetails", "Tasks", "Employee", new { id = @item.TaskID, IsRoute = true }, null)</text>, "FirstColumn"));
        gridColumns.Add(grid.Column("StopDate", " تاريخ الايقاف", @<text>@item.HijriStopDate</text>, "SecondColumn"));

    }


            }
            @grid.GetHtml(columns: grid.Columns(gridColumns.ToArray()),
                   tableStyle: "table table-bordered dataTable",
                      headerStyle: "",
                   footerStyle: "pagerbar",
                      mode: WebGridPagerModes.All,
                      numericLinksCount: 5,
                      firstText: "الاول",
                      previousText: "السابق",
                      nextText: "التالى",
                      lastText: "الاخير"

             )


        </div>
    </div>


}
else
{
    <table width="100%" border="0" cellspacing="0" class="fav-grid tab1" style="display: table;">
        <tbody>
            <tr class="table-alternat-header">
           
            </tr>
            <tr>
                <td colspan="1" style="text-align: center">
                    <h4>لا يوجد بيانات</h4>
                </td>
            </tr>
        </tbody>
    </table>
}


