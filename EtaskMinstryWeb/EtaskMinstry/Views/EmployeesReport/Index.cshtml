@using EtaskMinstry;
@{
    ViewBag.Title = "تقرير الموظفين";
        Layout = "~/Views/Shared/_Layout.cshtml";
}


@using (Html.BeginForm("ViewReport", "EmployeesReport"))
{
    @Html.AntiForgeryToken()


    <div class="panel panel-info">
        <div class="panel-heading">
            <h6 class="panel-title panel-trigger">
                <a data-toggle="collapse" href="#panel-search" class="collapsed">بحث</a>
            </h6>
        </div>
        <div id="panel-search" class="panel-collapse collapse" style="height: 0px;">
            <div class="panel-body">
                <form>
                    <div class="row">
                        <div class="form-group col-sm-6">

                            <label class="col-sm-4 control-label">مزود الخدمة  : </label>
                            <div class="col-sm-8">
                                <div class='input-group date'>
                                    @Html.DropDownList("Provider", ViewBag.Providers as SelectList, "الكل",
    new
    {
    @id = "Provider",
    Class = "form-control",
    required = "مطلوب"

    })
                                    @Html.ValidationMessage("Provider", "مطلوب",
       new
       {
           Style = "Color:red;",
       })
                                </div>
                            </div>

                        </div>
                        <div class="form-group col-sm-6">

                            <label class="col-sm-4 control-label">إسم الشركة : </label>
                            <div class="col-sm-8">
                                <div class='input-group date'>
                                    @Html.DropDownList("CompanyId", new SelectList(ViewBag.companies, "Value", "Text"), "الكل",

    new
    {
        @id = "CompanyId",
        Class = "form-control"

    })
                                </div>
                            </div>

                        </div>

                    </div>
                    <div class="row">
                        <div class="form-group col-sm-6">

                            <label class="col-sm-4 control-label">تاريخ البداية : </label>
                            <div class="col-sm-8">
                                <div class='input-group date'>
                                    @Html.TextBox("FromDate", "", new { @class = "form-control", @readonly = "true" })
                                    <span class="input-group-addon">
                                        <span class="fa fa-calendar"></span>
                                    </span>
                                </div>
                            </div>

                        </div>
                        <div class="form-group col-sm-6">

                            <label class="col-sm-4 control-label">تاريخ النهاية : </label>
                            <div class="col-sm-8">
                                <div class='input-group date'>
                                    @Html.TextBox("ToDate", "", new { @class = "form-control", @readonly = "true" })
                                    <span class="input-group-addon">
                                        <span class="fa fa-calendar"></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-right">
                        <input type="submit" class="btn btn-primary" value="تقرير" />

                    </div>
                </form>
            </div>
        </div>
    </div>

}
<script src="~/Scripts/ui/ui.datepicker.js"></script>
<script src="~/Scripts/ui/i18n/jquery-ui-i18n.js"></script>
<script src="~/Scripts/ui/i18n/ui.datepicker-ar.js"></script>
<script>
    // #83: same date pickers as تقرير اداء الموظفين (Gregorian or Hijri per ISGreg)
    if ("@(MvcApplication.IsGregDate)" == "True") {
        $("#FromDate").datepicker($.datepicker.regional["ar"]);
        $("#ToDate").datepicker($.datepicker.regional["ar"]);
    }
    else {
        $('#FromDate,#ToDate').calendarsPicker({
            changeMonth: true,
            changeYear: true,
            showTrigger: '#calImg',
            calendar: $.calendars.instance('ummalqura'),
            dateFormat: 'dd/mm/yyyy',
            yearRange: '1418:1450'
        });
    }

    // Block a start date after the end date
    $('#FromDate').closest('form').on('submit', function (e) {
        var from = $('#FromDate').val(), to = $('#ToDate').val();
        if (from != "" && to != "" && HijridateCompare(to, from) < 0) {
            e.preventDefault();
            alert("لا يمكن اختيار تاريخ البداية اكبر من تاريخ النهاية");
        }
    });

    $('#Provider').change(function () {
        debugger;
        $.ajax({
            type: 'post',
            url: '/EmployeePerformanceReport/GetCompanies?provider=' + $('#Provider').val(),
            contentType: "application/json",
            dataType: "json",
            success: function (data) {
                $("#CompanyId").html("");
                $("#CompanyId").append($('<option/>', {
                    value: "",
                    text: "الكل"
                }));
                debugger
                $.each(data, function (index, item) {
                    $("#CompanyId").append($('<option/>', {
                        value: item.Value,
                        text: item.Text
                    }));
                });
            }
        });
    });
    </script>