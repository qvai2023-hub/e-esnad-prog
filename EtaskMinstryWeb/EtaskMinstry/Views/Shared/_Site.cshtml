<!-- Menu Toggle Script -->
    <script>

       
        var path = window.location.pathname;
        if (path == "/" || path == "")
            $('.nav li').first().addClass('active');
            else
         $('.nav li a[href="' + path + '"]').parent().addClass('active');

        $(".nav").find("")
        $("#menu-toggle").click(function (e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
            var iconEl = document.getElementById('icon');

            var options = {};
            var isbarCLass = $($("#menu-toggle").children()[0]).hasClass("fa-bars");
            if (isbarCLass) {
                options = {
                    from: 'fa-bars',
                    to: 'fa-arrow-right',
                    animation: 'rubberBand'
                };
            } else {
                options = {
                    from: 'fa-arrow-right',
                    to: 'fa-bars',
                    animation: 'rubberBand'
                };
            }


            iconate(iconEl, options);
        });
        new WOW().init();




    </script>
   

