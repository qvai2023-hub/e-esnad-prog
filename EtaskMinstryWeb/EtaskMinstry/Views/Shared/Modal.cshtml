    <script type="text/javascript">

        $(document).on('click', '#btn-sub', function () {

            $("#btn-sub").attr('disabled', 'disabled');
        });
        function Modal(options) {
            debugger
            var settings =
                {
                    title: '',
                    message: '',
                    id: '',
                    type: 'form',
                    onAccept: false,
                    onCancel: false
                };
            //  alert(options)
            $.extend(settings, options);
            $this_class = this; debugger;
            var my_modal_id = 'modal_' + Math.floor((Math.random() * 1000) + 1);
            var modal_object = $('.modal_template').clone().removeClass('modal_template');
            modal_object.attr('id', my_modal_id);



            this.init = function () {
                debugger;
                modal_object.find('.modal_title').html(settings.title);
                if (settings.id != '')
                    modal_object.find('.modal_content').append($('#' + settings.id));
                else
                    modal_object.find('.modal_content').html(settings.message);

                $('body').prepend(modal_object);
            }


            modal_object.find('.modal_btn_accept').click(function () {
                // alert("sss"+my_modal_id)
                if (settings.onAccept)
                    settings.onAccept($('#' + my_modal_id));

            });

            modal_object.find('.modal_btn_cancel').click(function () {
                if (settings.onCancel)
                    settings.onCancel($('#' + my_modal_id));
                else
                    $this_class.hide();
            });
            this.show = function () {
                debugger;
                // Add backdrop
                if (!$('.modal-backdrop-custom').length) {
                    $('body').append('<div class="modal-backdrop-custom" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1040;"></div>');
                }
                $('#' + my_modal_id).css({ 'display': 'block', 'z-index': '1050' });
                switch (settings.type) {
                    case 'confirm':
                        modal_object.find('.modal_btn_cancel, .modal_btn_accept').show();
                        break;
                    case 'alert':
                        modal_object.find('.modal_btn_cancel').hide();
                        break;
                    case 'alertMessage':
                        modal_object.find('.modal_btn_accept, .modal_btn_cancel').hide();
                        modal_object.find('.pop-close').show();
                        break;
                    default:
                        modal_object.find('.modal_btn_accept, .modal_btn_cancel').hide();
                        break;
                }
            }

            this.hide = function () {
                $('#' + my_modal_id).hide();
                $('.modal-backdrop-custom').remove();
            }

            this.init();
        }

        Modal.hide = function () {
            $('.modal').hide();
            $('.modal-backdrop-custom').remove();
        }
        Modal.showMessage = function (options, message) {
            var settings =
            {
                title: '',
                message: '',
                type: 'alert',
                onAccept: function (e) {
                    $(e).hide();
                },
                time: 5000
            };

            if (message !== undefined) {
                settings =
                {
                    title: options,
                    message: message,
                    type: 'alert',
                    onAccept: function (e) {
                        $(e).hide();
                    },
                    time: 5000
                };
            }
            else
                $.extend(settings, options);

            var messageModal = new Modal(settings)
            messageModal.show();
            if (settings.time !== false)
                setTimeout(function () { messageModal.hide(); }, settings.time);
        }

        //Type

        function Notify(type, message, time_to_close) {
            debugger
            var $notify = $('<div style="margin:10px;margin-bottom: 30px;"/>')
                .addClass('alert')
                .addClass('alert-' + type)
                .html(message)
                .click(function () {
                    $notify.remove();
                });

            $('.breadcrumb-line').after($notify);

            if (time_to_close == undefined)
                time_to_close = 5000;
            if (time_to_close !== false)
                setTimeout(function () {
                    $notify.remove();
                }, time_to_close);

        }

    </script>
