@using EtaskMinstry;
@*<div class="editor-field">*@
            <input type="file" id="fileImage" name="fileImage" class="btn btn-success form-control"/>
            <img width="20" height="20" id="imgSt" style="display:none"/>
            <input type="hidden" name="hiddenfileName" id="hiddenfileName"/>
            <input type="hidden" id="isFileValid" />
            <span class="UploadErrorMsg">
            </span>
@*</div>*@
@{
    Layout = null;
}
<script>
    $('#fileImage').change(function (evt) {
        //////////////////////////// for Update Img Src When FileUpload Changed
        debugger;
        var files = evt.target.files;
       // var type = evt.target.files[0].type;
        var Extentions = "@System.Configuration.ConfigurationManager.AppSettings["FileExtentions"]";
        var size = "@System.Configuration.ConfigurationManager.AppSettings["maxfileSize"]";
        var fileType = "";
        var picReader = new FileReader();
        if (files.length > 0) {
            picReader.readAsBinaryString(files[0]);
        } else {
            $('#hiddenfileName').val("");
            $("#imgSt").attr('src', '/Content/Main/images/PDF-icon.png').hide();
            $('.UploadErrorMsg').text('');
        }
        picReader.onload = function (e) {
            fileType = e.target.result.trim().substring(0, 10);

            if (files.length > 0) {
                var ext = files[0].name.split('.').pop().toLowerCase();

                var bReturn = CheckIsValid(Extentions, ext, fileType);
                if (bReturn == false) {
                    $('.UploadErrorMsg').text('غير مسموح بنوع الملف').css('color', 'red');
                    $("#imgSt").hide();
                    return false;
                }
                else if (files[0].size > size) {
                    $('.UploadErrorMsg').text('يجب ان لا يتجاوز حجم الملف 10 ميجا').css('color', 'red');
                    $("#imgSt").hide();
                    return false;
                }
                else {
                    var reader = new window.FileReader();
                    reader.onload = (function () {
                        return function (e) {
                            $('.UploadErrorMsg').text('');
                            if (ext == 'pdf') {
                                $("#imgSt").attr('src', '/Content/Main/images/PDF-icon.png').show();
                            }
                            else if (ext == 'doc' || ext == 'docx') {
                                $("#imgSt").attr('src', '/Content/Main/images/Word-icon.png').show();
                            }
                            else if (ext == 'xls' || ext == 'xlsx') {
                                $("#imgSt").attr('src', '/Content/Main/images/Excel-icon.png').show();
                            }
                            else if (ext == 'txt') {
                                $("#imgSt").attr('src', '/Content/Main/images/txt-icon.png').show();
                            }
                            else {
                                $("#imgSt").attr('src', '/Content/Main/images/img-icon.png').css({ 'width': '50px', 'height': '50px' }).show();
                            }

                            $('.UploadErrorMsg').text('تم اختيار الملف، سيتم رفعه عند الحفظ').css('color', '#0a7ec2');
                            $('#hiddenfileName').val(files[0].name);
                            $('#isFileValid').val('1');
                            $('#trUploadvalidation')[0].innerHTML = '';
                        };
                    })(files[0]);
                    reader.readAsDataURL(files[0]);
                }
            }
        };
       
        
        $.validator.addMethod("maxfilesize", function (value, element) {
            return element.files[0].size < 1024 * 1024 * 2;
        }, 'حجم هذا الملف لايمكن ان يتجاوز 2 ميجابايت');

        $.validator.addMethod("limitfiletype", function (value, element) {

            var ext = value.split('.').pop().toLowerCase();
            return ext == 'jpg' || ext == 'jpeg' || ext == 'png';
        }, 'امتداد هذا الملف غير مسموح به');
    });

    // Bug #60 (Round 2): the previous beforeunload guard was triggering Chrome's
    // confusing native "Leave site?" dialog — clicking Cancel left the user looking
    // at a frozen overlay, and the dialog text ("Changes you may not be saved") was
    // misleading because the upload actually completed on the server side.
    // Browsers do NOT allow custom messages in beforeunload (security feature),
    // so we cannot show a custom "Wait / Leave" dialog. Instead we drop beforeunload
    // entirely and rely on a clear, modal, animated overlay that communicates
    // the upload state without any browser dialog.
    (function () {
        // CSS for marquee progress bar (animated motion = "still working")
        if ($('#uploadOverlayCss').length === 0) {
            $('head').append(
                '<style id="uploadOverlayCss">' +
                '@@keyframes tlskUploadStripe { 0%{background-position:0 0;} 100%{background-position:40px 0;} }' +
                '#uploadOverlay .tlsk-bar { height:8px; width:100%; background:#444; border-radius:4px; overflow:hidden; margin-top:18px; }' +
                '#uploadOverlay .tlsk-bar > div { height:100%; width:100%;' +
                '  background-image: linear-gradient(45deg, rgba(255,255,255,.25) 25%, transparent 25%, transparent 50%, rgba(255,255,255,.25) 50%, rgba(255,255,255,.25) 75%, transparent 75%, transparent);' +
                '  background-size: 40px 40px;' +
                '  background-color: #5cb85c;' +
                '  animation: tlskUploadStripe 1s linear infinite; }' +
                '#uploadOverlay .tlsk-elapsed { font-size:13px; color:#aaa; margin-top:10px; }' +
                '</style>'
            );
        }

        // On any form submit on a page that includes the upload partial, show an overlay
        // and disable submit. This blocks user interaction until the POST completes
        // (page navigates on success/failure, removing the overlay).
        $(document).on('submit', 'form', function () {
            if (!$('#hiddenfileName').val()) return; // no file attached → normal submit
            $(this).find('input[type=submit], button[type=submit]').prop('disabled', true);
            if ($('#uploadOverlay').length === 0) {
                $('body').append(
                    '<div id="uploadOverlay" style="position:fixed;top:0;left:0;width:100%;height:100%;' +
                    'background:rgba(0,0,0,0.65);z-index:99999;display:flex;align-items:center;' +
                    'justify-content:center;color:#fff;direction:rtl;">' +
                    '<div style="text-align:center;background:#222;padding:34px 44px;border-radius:8px;max-width:460px;">' +
                    '<i class="fa fa-cloud-upload fa-3x" style="margin-bottom:15px;color:#5cb85c;"></i><br/>' +
                    '<div style="font-size:20px;font-weight:bold;">جاري رفع الملف...</div>' +
                    '<div style="font-size:14px;margin-top:10px;color:#ddd;">' +
                    'يرجى عدم إغلاق الصفحة أو الضغط على زر التحديث.<br/>' +
                    'قد يستغرق رفع الملفات الكبيرة دقيقة أو دقيقتين.' +
                    '</div>' +
                    '<div class="tlsk-bar"><div></div></div>' +
                    '<div class="tlsk-elapsed">الوقت المنقضي: <span id="tlskElapsed">0</span> ثانية</div>' +
                    '</div></div>'
                );
                // Time-elapsed counter so the user sees motion proving the page isn't frozen
                var start = Date.now();
                window.tlskUploadTimer = setInterval(function () {
                    var sec = Math.floor((Date.now() - start) / 1000);
                    $('#tlskElapsed').text(sec);
                }, 1000);
            }
        });
    })();

    // Bug #60 (Round 2): show "تم الرفع بنجاح" success toast after a successful
    // attachment upload. Both Company and Employee AddAttachment actions redirect
    // to TaskDetails with ?isAttach=1, so we detect that on page load and show
    // the toast, then clean the URL so a refresh doesn't show it again.
    $(document).ready(function () {
        var qs = window.location.search;
        if (qs && qs.indexOf('isAttach=1') !== -1) {
            if ($('#uploadSuccessToast').length === 0) {
                $('body').append(
                    '<div id="uploadSuccessToast" style="position:fixed;top:80px;left:50%;' +
                    'transform:translateX(-50%);background:#5cb85c;color:#fff;' +
                    'padding:14px 28px;border-radius:6px;font-size:16px;z-index:100000;' +
                    'box-shadow:0 4px 12px rgba(0,0,0,.25);direction:rtl;">' +
                    '<i class="fa fa-check-circle" style="margin-left:8px;"></i>' +
                    'تم الرفع بنجاح' +
                    '</div>'
                );
                setTimeout(function () { $('#uploadSuccessToast').fadeOut(400, function () { $(this).remove(); }); }, 3500);
            }
            // Clean the URL so refreshing the page doesn't re-show the toast
            if (window.history && window.history.replaceState) {
                var newSearch = window.location.search.replace(/[?&]isAttach=1/, '').replace(/^&/, '?');
                if (newSearch === '?') newSearch = '';
                var cleanUrl = window.location.pathname + newSearch;
                window.history.replaceState({}, document.title, cleanUrl);
            }
        }
    });

    function CheckIsValid(Extentions, ext, fileType) {
        var valid = false;

        if (Extentions.indexOf(ext) >= 0) {
            //for pdf, PDF
            if (fileType.indexOf("%PDF") >= 0) {
                valid = true;
            }
                //DOCX, PPTX, XLSX
            else if (fileType.indexOf("PK") >= 0) {
                valid = true;
            }
                //DOC, DOT, PPS, PPT, XLA, XLS, WIZ
            else if (fileType.indexOf("ÐÏ.à¡±.á") >= 0 || fileType.indexOf("ÐÏà¡±á") >= 0) {
                valid = true;
            }
                //JFIF, JPE, JPEG, JPG
            else if (fileType.indexOf("ÿØÿà") >= 0) {
                valid = true;
            }
                //PNG
            else if (fileType.indexOf("PNG") >= 0) {
                valid = true;
            }

        }
        else { valid = false; }
        return valid;
    }
</script>