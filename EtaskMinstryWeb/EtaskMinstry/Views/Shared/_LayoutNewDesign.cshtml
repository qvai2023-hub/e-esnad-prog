    <script type="text/javascript">



        window.onload = function () {
            var path = window.location.pathname;
            //$(".sm-ul").find('li').removeClass("active-menu");
            $('.sm-ul li a[href="' + path + '"]').parent().addClass('active-menu');
        };

        $(function () {
            $('#txtQuickSearch').val('@Request.QueryString["t"]');
            $('.tab').click(function () {
                $('.tab').removeClass('active-tab').addClass('dactive-tab');

                if ($(this).parent().parent().hasClass("more-tasks")) {
                    $(".more-tasks li a").css('background-color', 'white');
                    $(this).css('background-color', 'rgba(211, 140, 51, 0.21)');
                    $("#more-tasks").addClass('active-tab').removeClass('dactive-tab');
                } else
                    $(this).addClass('active-tab').removeClass('dactive-tab');

                $('.tab_cont').hide();
                $('.tab' + $(this).attr('tab')).show();
            });

            $('.delete_attch').click(function () {
                $(this).parent().parent().next().hide('slow');
                $(this).parent().parent().hide('slow');
            });

            var SelectedItemId = 0;

            var DeleteRow = new Modal({
                title: 'حذف', //title of the popup
                message: 'تأكيد عملية الحذف', // message text  notes: overrided if there're  id form
                type: 'confirm',  // type of the modal 'alert', 'confirm' or 'form'
                id: '',  // id of the form to show it on the modal
                onAccept: function () {

                    var currentController = '@HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString()';
                    currentController = currentController.substr(0, 1).toUpperCase() + currentController.substr(1);

                    $.ajax({
                        type: 'Post',
                        url: '@Url.Action("Delete")',
                        dataType: 'json',
                        data: { id: SelectedItemId, CurrenClass: currentController },
                        success: function (data) {

                        },
                        error: function (e) {

                        },
                        complete: function (data) {

                            DeleteRow.hide();
                            $("#btnSearch").click();
                            //for DashBOard Delte
                            //if (currentController.toLowerCase() == 'dashboard') {

                            //    $('.reloadAssign').click();
                            //    $('.reloadAssign').next()[0].innerHTML = parseInt($('.reloadAssign').next()[0].innerHTML) - 1;
                            //}
                            //if (data.responseText.toLowerCase() == "true") {
                            //    Notify("success ", "تم الحذف بنجاح", 3000);
                            //    $("#btnSearch").click();
                            //}else
                            //    Notify("danger", "لم يتم الحذف ", 3000);
                        }
                    });
                },// call back runs after modal accept,
                onCancel: function () {
                    DeleteRow.hide();
                } // call back runs after modal cancel default  is false , closes the modal.
            });

            //Open Confirmation popUp when Click on Delete icon.
            $('.iconbox .icon-trash-1').live('click', function (e) {

                e.preventDefault();

                SelectedItemId = $(this).attr('id');

                DeleteRow.show();
            });

            // To Implement Pager Functionality & To Prevent Show Grid In new Page .
            $("th a,tfoot .pagerbar a").live("click", function () {
                $('#SearchForm').attr('action',
                    $('#SearchForm').attr('action').split('?')[0] + "?" + $(this).attr("href").split('?')[1]).submit();
                return false;
            });


        });

        //});
        //Compare HIjriDate
        //in format of dd/mm/yyyy
        //return 0 if equl
        //1 if first greater
        //-1 if first smaller
        //-2 if error
        function HijridateCompare(date1, date2) {
            if (date1.split('/').length < 3 || date2.split('/').length < 3)
                return -2;
            if (parseInt(date1.split('/')[2]) > parseInt(date2.split('/')[2]))
                return 1;
            else if (parseInt(date1.split('/')[2]) < parseInt(date2.split('/')[2]))
                return -1;
            else if (parseInt(date1.split('/')[1]) > parseInt(date2.split('/')[1]))
                return 1;
            else if (parseInt(date1.split('/')[1]) < parseInt(date2.split('/')[1]))
                return -1;
            else if (parseInt(date1.split('/')[0]) > parseInt(date2.split('/')[0]))
                return 1;
            else if (parseInt(date1.split('/')[0]) < parseInt(date2.split('/')[0]))
                return -1;
            else return 0;
        }
        ///////////////////////////////////////////////////////////////////////////
        //Compare GregDate
        //in format of dd/mm/yyyy
        //return 0 if equl
        //1 if first greater
        //-1 if first smaller
        //-2 if error
        function dateCompare(date1, date2) {
            if (date1.split('/').length < 3 || date2.split('/').length < 3)
                return -2;
            if (parseInt(date1.split('/')[2]) > parseInt(date2.split('/')[2]))
                return 1;
            else if (parseInt(date1.split('/')[2]) < parseInt(date2.split('/')[2]))
                return -1;
            else if (parseInt(date1.split('/')[1]) > parseInt(date2.split('/')[1]))
                return 1;
            else if (parseInt(date1.split('/')[1]) < parseInt(date2.split('/')[1]))
                return -1;
            else if (parseInt(date1.split('/')[0]) > parseInt(date2.split('/')[0]))
                return 1;
            else if (parseInt(date1.split('/')[0]) < parseInt(date2.split('/')[0]))
                return -1;
            else return 0;
        }
        //apply classes to web grid.................................................
        function applyClassesToWebGrid() {
            //to replace href from # to void
            $(".pagerbar td a").each(function () {
                if ($(this).text().length < 4) {
                    $(this).addClass('number');
                    //$(this).attr("href", "javascript:void(0);");
                }
                else {
                    $(this).addClass('pgr');
                    //$(this).attr("href", "javascript:void(0);");
                }
            });

            $(".pagerbar td").contents().each(function () {
                if ($(this).is(":not('a')") && $(this).is(":not('span')") && $(this).text() != ' ') {
                    $(this).wrap("<span class='active' />");
                }
            });

            // Apply Css For Links
            $('li a.cat-active').each(function () {
                if (this.href.toLowerCase() == window.location.href.toLowerCase()) {
                    $(this).css({ "color": "#bd7d0e" });
                }
            });
        }



    ///////////////////////////////////////////////////////////////////////////////////////////////////
