    <script src="~/Scripts/ui/ui.datepicker.js"></script>
    <script src="~/Scripts/ui/i18n/jquery-ui-i18n.js"></script>
    <script src="~/Scripts/ui/i18n/ui.datepicker-ar.js"></script>
    <script>
    $('#CompanyId').change(function () {
        debugger;
        $.ajax({
            type: 'post',
            url: '/Attendance/GetEmployees?companyId='+$('#CompanyId').val(),
            contentType: "application/json",
            dataType: "json",
            //data: { "companyId": $('#CompanyId').val() },
            success: function (data) {
                $("#EmployeeId").html("");
                $("#EmployeeId").append($('<option/>', {
                    value: "",
                    text: "الكل"
                }));
                debugger
                    $.each(data, function (index, item) {
                        $("#EmployeeId").append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
            }
        });
    });
        $('#Provider').change(function () {
            debugger;
            $.ajax({
                type: 'post',
                url: '/Attendance/GetCompanies?provider=' + $('#Provider').val(),
                contentType: "application/json",
                dataType: "json",
                success: function (data) {
                    $("#CompanyId").html("");
                    $("#CompanyId").append($('<option/>', {
                        value: "",
                        text: "الكل"
                    }));
                    debugger
                    $.each(data, function (index, item) {
                        $("#CompanyId").append($('<option/>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                }
            });
        });

     //Check Date Greg OR Hijrii
    function initCalendar() {
        var calType = $("#calendarType").val();
        // Clear existing pickers and values
        $("#FromDate, #ToDate").val("");
        try { $("#FromDate, #ToDate").datepicker("destroy"); } catch(e) {}
        try { $('#FromDate, #ToDate').calendarsPicker("destroy"); } catch(e) {}

        if (calType == "1") {
            //datepicker Grerg
            $("#FromDate").datepicker($.datepicker.regional["ar"]);
            $("#ToDate").datepicker($.datepicker.regional["ar"]);
        }
        else {
            //calendar Hijrii
            $('#FromDate,#ToDate').calendarsPicker({
                changeMonth: true,
                changeYear: true,
                showTrigger: '#calImg',
                calendar: $.calendars.instance('ummalqura'),
                dateFormat: 'dd/mm/yyyy',
                yearRange: '1418:1450'
            });
        }
    }
    initCalendar();
    $("#calendarType").change(function() { initCalendar(); });
    //***************************************************************//

    $.validator.addMethod("MinMaxValidation", function (value, element, options) {
        var isValid = false;
        debugger;
        var FromValue = $('#FromDate').val();
        var ToValue = $('#ToDate').val();
        if ($('#ToDate').val() != "" && $('#FromDate').val() != "" && HijridateCompare(ToValue, FromValue) < 0)
            isValid = false;
        else
            isValid = true;
        return isValid;
    });
    $.validator.addMethod("MinMaxEndDateValidation", function (value, element, options) {
        var isValid = false;
        debugger;
        var FromValue = $('#FromEndDate').val();
        var ToValue = $('#ToEndDate').val();
        if ($('#ToEndDate').val() != "" && $('#FromEndDate').val() != "" && HijridateCompare(ToValue, FromValue) < 0)
            isValid = false;
        else
            isValid = true;
        return isValid;
    });

        $('#fromYear').change(function () {
            debugger;
            $.ajax({
                type: 'post',
