@model EtaskMinstry.Models.ContactUs

@{
    ViewBag.Title = "اتصل بنا";
    Layout = "~/Views/Shared/_Site.cshtml";
}

 <div id="page-content-wrapper">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12">


<div class="panel panel-default"><h3 class="default-ttl"> اتصل بنا</h3>

<p>نرحب بتواصلكم معنا، ونستقبل استفساراتكم ومقترحاتكم من خلال تعبئة النموذج أدناه...</p>
@{
    string msg= ViewBag.SuccessMessage== null? "": "تم الارسال بنجاح";
<p style="color:RGB(30,221,183)">@msg</p>

}
  
@using (Html.BeginForm("ContactUs","Site"))
{
      @Html.AntiForgeryToken()
      @Html.ValidationSummary(true, "", new { @class = "ErrorMessage" })
                
           

  
    <div class="form-group">
        <label for="input1"><span class="text-danger">*</span> الاسم </label>
         @Html.TextBoxFor(model => Model.Name , new{ Class = "form-control", placeholder = "الاســـــم"})
           <span class="text-danger"> @Html.ValidationMessageFor(model => model.Name )</span>
        </div>
        
        

        <div class="form-group">
        <label for="input1"><span class="text-danger">*</span> البريد الإلكتروني </label>
         @Html.TextBoxFor(model => model.Email , new{ Class = "form-control", placeholder = "البريد الإلكتروني"})
           <span class="text-danger"> @Html.ValidationMessageFor(model => model.Email )</span>
        </div>

        <div class="form-group">
        <label for="input1"><span class="text-danger">@***@</span> الهاتف الجوال </label>
         @Html.TextBoxFor(model => model.Mobile , new{ Class = "form-control", placeholder = "الهاتف الجوال"})
          <span class="text-danger">  @Html.ValidationMessageFor(model => model.Mobile )</span>
        </div>

         <div class="form-group">
    <label for="input5"><span class="text-danger">@***@</span>  نوع الرسالة </label>
    <select class="form-control" id="input5">
    <option>اختر</option>
    <option>استفسار</option>
    <option>شكوى</option>
    <option>طلب</option>
    <option>أخرى</option>
    
    
    </select>
              
  </div>
    <div class="form-group">
    <label for="input4"><span class="text-danger">*</span>  الرسالة </label>
      @Html.TextAreaFor(model => model.Message , new{ Class = "form-control", placeholder = "الرسالة"})
      <span class="text-danger"> @Html.ValidationMessageFor(model => model.Message )</span>
  </div>

  <div class="text-right">
    <input type="submit" class="btn btn-primary" value="إرسال"/>
    <input id="btn-cancel" onclick="clearData()" type="button" class="btn btn-default" value="إلغاء" />
  </div>

}

    <script>


        function clearData() {
            $('span.text-danger').hide();
            $('.form-group').find('input').val('')
            $('.form-group').find('textarea').val('')
            $('.form-group').find('select').val(0);
        }
      
    </script>


</div>


  

  
  

<a href="#menu-toggle" class="btn btn-link" id="menu-toggle"> <i id="icon" class="fa fa-bars fa-lg"></i></a>
                    </div>
                </div>
            </div>
        </div>

