@{
    Layout = null;
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>

    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>E-snad | برنامج إدارة المهام</title>
    <link href="/Content/Main/reset.css" rel="stylesheet" />
    <link href="/Content/Main/main.css" rel="stylesheet" />
    <link href="/Content/Main/960.css" rel="stylesheet" />
    <link href="/Content/Main/internal.css" rel="stylesheet" />
    @*  <link href="/Content/Main/login-style.css" rel="stylesheet" />*@
    <link href="/Content/Main/Developers.css" rel="stylesheet" />
    @*  <link rel="shortcut icon" href="/Content/Main/images/favicon.ico" />*@
    <link rel="shortcut icon" href="/Content/Main/images/favicon.ico" type="image/x-icon" />

    <script src="/Scripts/jquery-1.7.1.min.js" type="text/javascript"></script>
    <script src="/Scripts/jquery.validate.min.js" type="text/javascript"></script>

    <script type="text/javascript">
        $(function () {
            //$('#btnLogin').click(function () {
            //    var email = $('#txtEmail').val();
            //    if (email == 'company')
            //        window.location = 'company-dash1.html';
            //    else
            //        window.location = 'user-dash1.html';

            //});

            $("#ForgetPassForm").validate({
                rules: {

                    Email: {
                        required: true,
                        email: true
                    }
                },
                messages: {

                    Email: {
                        email: "بريد الكترونى غير صحيح .",
                        required: "*"
                    }

                },

                errorElement: 'div',
                errorLabelContainer: '.errMsg',
                //place all errors in a <div id="errMsg"> element
                errorPlacement: function(error, element) {
                    error.appendTo("div#errMsg");
            }
                //submitHandler: function () {
                //    alert("form valid");

                //},
                //invalidHandler: function (event, validator) {

                //}
            });
        });
    </script>
    <style>
        .login-box label.error {
            color: red;
            width: 150px;
        }
    </style>
</head>
<body>

    <div class="logo">
        <img style="width: 254px" src="/Content/Main/images/logo.png" />
    </div>
    <div class="login" id="login">


        @using (Html.BeginForm("ForgetPasswoed", "Security", null, FormMethod.Post, new { id = "ForgetPassForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "errMsg" })

            <h2>استعادة كلمة المرور</h2>
            <br />
                <div class="row username">
                    @Html.TextBox("Email", null, new { placeholder = "البريد الإلكترونى الخاص بك" })
                </div>
                <div style="color: red;" id="errMsg">
                </div>
                <div class="buttonHolder">
                    <input class="submit-btn button" id="btnLogin" type="submit" value="ارسال" />
                </div>



        }
    </div>

    <footer>
        جميع الحقوق محفوظة ©
        برنامج إدارة المهام 2017
        -
        تم التطوير بواسطة <a target="_blank" href="http://qvsite.com">Q-Vision</a>
    </footer>
    <style>
        #sitelock_shield_logo {
            z-index: 100001;
        }
    </style>
</body>
</html>
