    <script type="text/javascript">
        $(function () {
            //stop pass textbox from autoComplete
            $("input:password").attr("autocomplete", "off");
            $('#btnLogin').click(function () {
                debugger;
                var i, isValid=true, specialChars = ['<', '>', '/', ';'];
                var email = $('#username').val();
                var Password = $('#password1').val();
                for (i = 0; i < specialChars.length; i++) {
                    if (email.indexOf(specialChars[i]) > -1 || Password.indexOf(specialChars[i]) > -1) {
                        isValid = false;
                        break;
                    }
                }
                if (!isValid) {
                    $("#errMsg").text("اسم مستخدم او كلمة مرور غير صحيحة");
                }
                else {
                    $("#errMsg").text("");
                }
                return isValid;



            });
        });
    </script>
</head>
<body>
    @* start ssl sectificat*@
    <div id="sitelock_shield_logo" class="fixed_btm" style="bottom: 0; position: fixed; _position: absolute; right: 0;">
        <a href="https://www.sitelock.com/verify.php?site=www.etask-proj.com" onclick="window.open('https://www.sitelock.com/verify.php?site=www.etask-proj.com','SiteLock','width=600,height=600,left=160,top=170');return false;">
            <img alt="PCI Compliance and Malware Removal" title="SiteLock" src="//shield.sitelock.com/shield/www.etask-proj.com"></a>

        <span id="siteseal">
            <script type="text/javascript" src="https://seal.godaddy.com/getSeal?sealID=eh4q4h6UOkKS4t4M6Ei32Kb1y65BwTasjecKl9egS0NjBFi8l7rYrvA7kRmo"></script>
        </span>
    </div>


    @* end ssl sectificat*@
    <div class="logo">
        <img style="width:254px"  src="/Content/Main/images/logo.png" /></div>
    <div class="login" id="login">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "ErrorMessage" })
                
           
          
            <div class="row username">
                @*  @Html.LabelFor(model => model.UserName)*@
                @Html.TextBoxFor(model => model.UserName, new { placeholder = "الاســـــم", id = "username", })
                @Html.ValidationMessageFor(model => model.UserName)
            </div>
            <div class="row pass">
                @* @Html.LabelFor(model => model.Password)*@
                @Html.PasswordFor(model => model.Password, new { placeholder = "كلمة المرور", id = "password1" })
                @Html.ValidationMessageFor(model => model.Password)
              
            </div>
            
            <div>
                <label class="remember checkbox" style="margin-right: 78px; margin-top: 5px;">
                  @*  @Html.LabelFor(model => model.RememberMe)
                    @Html.CheckBoxFor(model => model.RememberMe, new { @class = "remember-me" })*@
                    <span class="pull-left">
                        @*<a href="/Security/ForgetPasswoed">نسيت كلمة المرور ؟</a>*@
                    </span>
                </label>



            </div>
            <div id="errMsg" style = "color: red;margin-right: 95px;">
            @if (Html.ValidationMessage("LoginField") != null)
            {
            @Html.Raw(Html.ValidationMessage("LoginField", new { @style = "color: red;margin-right: 95px;" }).ToString())
            }
                </div>
            <div class="buttonHolder">
                <input class="submit-btn button" id="btnLogin" type="submit" value="تسجيل الدخول" />
            </div>              
        }
    </div>
    <footer>
        جميع الحقوق محفوظة ©
        برنامج إدارة المهام 2017
        -
        تم التطوير بواسطة <a target="_blank" href="http://qvsite.com">Q-Vision</a>
        </footer>
    <style>
        #sitelock_shield_logo {
            z-index: 100001;
        }
    </style>
</body>
</html>
