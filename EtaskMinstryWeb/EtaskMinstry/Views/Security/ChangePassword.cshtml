@model EtaskMinstry.Models.Login.UserAccountVM
@{
    ViewBag.Title = "ChangePassword";
}

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">


<html>
<head>
    <title>@System.Configuration.ConfigurationManager.AppSettings["ApplicationName"] | برنامج إدارة المهام</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1, maximum-scale=1" />
    <!--css-->
    <link href="~/Content/Site/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/Site/css/bootstrap-arabic.min.css" rel="stylesheet" />
    <link href="~/Content/Site/css/normalize.css" rel="stylesheet" />
    <link href="~/Content/Site/css/animate.css" rel="stylesheet" />
    <link href="~/Content/Site/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/Site/css/style.css" rel="stylesheet" />
    <!-- Modernizr -->

    <script src="~/Content/Site/js/modernizr.js"></script>

    <script src="~/Scripts/jquery-1.7.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
</head>

<body class="full-width page-condensed">


    <!-- Navbar -->
    <div class="navbar navbar-inverse" role="navigation">
        <div class="navbar-header">

            <a class="navbar-brand" href="#"><img src="~/Content/Site/img/logo.png" alt="logo" /></a>
        </div>


    </div>
    <!-- /navbar -->
    <!-- Login wrapper -->
    <div class="container">
        <div class="row login-sec">
            <div class="login-wrapper" style="width: 50%; margin: 0 auto;">
                <form action="#" role="form" id="changePassform">
                    <div class="popup-header">
                        @*<a href="#" class="pull-left"><i class="fa fa-user-plus"></i></a>*@
                        <span class="text-semibold">تغيير كلمة المرور</span>
                        @*<div class="btn-group pull-right">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-cogs"></i></a>
                            <ul class="dropdown-menu icons-right dropdown-menu-right">
                                <li><a href="#"><i class="fa fa-users"></i> مستخدم آخر</a></li>
                                <li><a href="#"><i class="fa fa-info"></i> نسيت كلمة المرور؟</a></li>
                                <li><a href="#"><i class="fa fa-support"></i> مساعدة</a></li>
                                <li><a href="#"><i class="fa fa-wrench"></i> إعدادات</a></li>
                            </ul>
                        </div>*@
                    </div>
                    <div class="well">
                        <div class="form-group has-feedback">
                            @Html.PasswordFor(model => model.OldPassword, new { @class = "form-textbox form-control", placeholder = "كلمة المرور القديمة" })
                            <br />
                            @Html.ValidationMessageFor(model => model.OldPassword, null,
                    new
                    {
                        Style = "Color:red;",
                        @id = "TitleValidation"
                    })
                        </div>

                        <div class="form-group has-feedback">
                            @Html.PasswordFor(model => model.NewPassword, new { @class = "form-textbox form-control", placeholder = "كلمة المرور الجديدة" })
                            <br />
                            @Html.ValidationMessageFor(model => model.NewPassword, null,
                    new
                    {
                        Style = "Color:red;",
                        @id = "TitleValidation"
                    })
                        </div>
                        <div class="form-group has-feedback">
                            @Html.PasswordFor(model => model.ConfirmNewPassword, new { @class = "form-textbox form-control", placeholder = "تأكيد كلمة المرور الجديدة" })
                            <br />
                            @Html.ValidationMessageFor(model => model.ConfirmNewPassword, null,
                    new
                    {
                        Style = "Color:red;",
                        @id = "TitleValidation"
                    })
                        </div>

                        <label id="error" style="color: red"></label>
                        <label id="success" style="color: green"></label>
                        <div class="row form-actions">
                            <div class="col-xs-12 buttonHolder">
                                <input type="submit" value="حفظ" id="btnSavePassword" class="btn btn-warning pull-right" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            </div>
        </div>
            <!-- /login wrapper -->
            <!-- Footer -->
            <div class="footer clearfix">
                <div class="pull-left">

                    جميع الحقوق محفوظة ©
                    برنامج إدارة المهام 2017
                    -
                    تم التطوير بواسطة <a target="_blank" href="http://qvsite.com">Q-Vision</a>
                @*&copy; 2015 إي تاسك مزود الخدمة المعتمد للعمل عن بعد - تم تطويره بواسطة <a href="#">كيوفيجن</a>*@
                
                </div>
                <div class="pull-right icons-group">
                    <a href="#"><i class="icon-screen2"></i></a>
                    <a href="#"><i class="icon-balance"></i></a>
                    <a href="#"><i class="icon-cog3"></i></a>
                </div>
            </div>
            <!-- /footer -->



            <script src="js/jquery-1.11.2.min.js" type="text/javascript"></script>
            <script src="js/bootstrap.min.js" type="text/javascript"></script>

        </div>

    </div>

</body>
</html>




<script>
    $(document).ready(function () {
        //add validation rule to search name
        $('#NewPassword').rules("add", { regex: "^[a-zA-Z0-9\u0600-\u06ff./\s_-]{4,8}$", required: true, messages: { required: "الرقم السرى الجديد مطلوب", regex: "كلمةالسر يجب أن تكون بين 4 و8 خانات وغير مسموح برموز خاصة" } });
        $('#ConfirmNewPassword').rules("add", { regex: "^[a-zA-Z0-9\u0600-\u06ff./\s_-]{4,8}$", required: true, messages: { required: "تأكيد الرقم السرى الجديد مطلوب", regex: "كلمةالسر يجب أن تكون بين 4 و8 خانات وغير مسموح برموز خاصة" } });
        $('#ConfirmNewPassword,#NewPassword').change(function () {
            debugger;
            if (!$('#ConfirmNewPassword,#NewPassword').valid()) {
                //  $("#error").text(" كلمة السر يجب ان تكون بين 4 و 8 حروف أو أرقام وغير مسموح برموز خاصة ");
            }
            else {
                //  $("#error").text("");
            }

        });

        $("#ConfirmNewPassword,#NewPassword").blur(function () {
            if ($('#ConfirmNewPassword,#NewPassword').valid()) {
                var newpass = $("#NewPassword").val();
                var confnewPass = $("#ConfirmNewPassword").val();

                if (newpass != confnewPass) {
                    $("#error").text("الخانات غير متطابقة");
                } else {
                    $("#error").text("");
                }
            }
        });
        $("#btnSavePassword").live("click", function (e) {
            if ($('#ConfirmNewPassword,#NewPassword').valid()) {
                var oldpass = $("#OldPassword").val();
                var newpass = $("#NewPassword").val();
                var confnewPass = $("#ConfirmNewPassword").val();

                if (newpass == confnewPass) {

                    $.ajax({
                        url: "/Security/ChangePassword",
                        dataType: "json",
                        type: "POST",
                        data: { "OldPassword": oldpass, "NewPassword": newpass },
                        success: function (result) {
                            if (result == false) {
                                $("#error").text("كلمة المرور غير صحيحة");
                            } else {
                                $("#error").text(" ");
                                $("#success").text("تم تغيير كلمة المرور بنجاح");
                                setTimeout(function () {
                                    window.location.href = "/Employee/Tasks";
                                }, 3000);
                            }
                        },
                        error: function (result) {


                            //alert("error");
                        }
                    });

                } else {
                    $("#error").text("الخانات غير متطابقة");
                }
            }
        });
    });
</script>
