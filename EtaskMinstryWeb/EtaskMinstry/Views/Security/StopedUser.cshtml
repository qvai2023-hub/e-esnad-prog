@{
    Layout = null;
    }
<html xmlns="http://www.w3.org/1999/xhtml"><script id="tinyhippos-injected">if (window.top.ripple) { window.top.ripple("bootstrap").inject(window, document); }</script><head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>حساب موقوف</title>
      <link rel="shortcut icon" href="/Content/Main/images/favicon.ico" type="image/x-icon" />
    <link href="/Content/Main/reset.css" rel="stylesheet" type="text/css">
    <link href="/Content/Main/960.css" rel="stylesheet" type="text/css">
    <link href="/Content/Main/internal.css" rel="stylesheet" type="text/css">
    <script src="/Scripts/jquery.js" type="text/javascript"></script>
    <script src="/Scripts/menu.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {

            $('#Task_Priority').change(function () {

                $('.strenth-colors').css("width", (parseFloat($('#Task_Priority :selected').val()) / 3) * 100 + "%");
            });
            $('.tab').click(function () {
                $('.tab').removeClass('active-tab').addClass('dactive-tab');
                $(this).addClass('active-tab').removeClass('dactive-tab');
                $('.fav-grid').hide();
                $('.tab' + $(this).attr('tab')).show();
            });
        });
    </script>
</head>
<body>
    <div class="overall-container">
        <div class="container_12">
            <div class="header">
                <a href="index.html" class="white-logo"></a>
                
                <div class="clear">
                </div>
                <div class="page-banner">
                    <img src="/Content/Main/images/company-dash-banner.png" width="945" height="124"></div>
                <div class="clear">
                </div>
            </div>
            <div class="grid_12" id="content-area">
                <div class="entery-form">
                    <div class="done-msg">
                        <i class="stop-account-done-icon"></i>
                        @if(EtaskMinstry.MvcApplication.userData != null){
                        <h2>@(EtaskMinstry.MvcApplication.userData.status!=(int)EtaskMinstry.userStatus.active?"تم إيقاف الحساب":"تم ايقاف حساب الشركة التى تعمل بها")
                        </h2>
                        }
                        <p>
                            <br />
                            <br />
                        </p>

                    </div>
                </div>
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="clear">
        </div>
    </div>
    <div class="footer">
        <div class="container_12">
            <div class="cr">
                جميع الحقوق محفوظة © 2012</div>
            <div class="clear">
            </div>
        </div>
    </div>

     
<script type="text/javascript">
    $(function () {
        $(".nav-holder").find("li:lt(3) a,li:last-child a:first").attr("href", "javascript:void(o)");
        $(".white-logo").attr("href", "javascript:void(o)");

    })
</script>
    </body>
    </html>