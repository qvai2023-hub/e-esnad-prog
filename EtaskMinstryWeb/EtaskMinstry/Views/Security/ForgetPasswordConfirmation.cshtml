<!DOCTYPE html>
<html>
<head>
    <title>E-snad | برنامج إدارة المهام</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1, maximum-scale=1" />
    <!--css-->
    <link href="~/Content/Site/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/Site/css/bootstrap-arabic.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site/css/animate.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site/css/style.css" rel="stylesheet" type="text/css" />
    <!-- Modernizr -->
    <script src="~/Content/Site/js/modernizr.js"></script>
    <script src="~/Scripts/jquery-1.7.1.js"></script>
</head>

<body class="full-width page-condensed">


    <!-- Navbar -->
    <div class="navbar navbar-inverse" role="navigation">
        <div class="navbar-header">

            <a class="navbar-brand" href="#"><img src="~/Content/Site/img/logo.png" alt="Londinium" /></a>
        </div>

    </div>
    <!-- /navbar -->
    <!-- Login wrapper -->
    <div class="container">
        <div class="row login-sec">
            <div class="">
                <div class="login-wrapper">
                   @using (Html.BeginForm())
        {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "errMsg" })

                <div class="popup-header">
                            <span class="text-semibold">استعادة كلمة المرور</span>
                        </div>
                        <div class="well">
                            <div class="form-group has-feedback">
                                <div style="color: red;" id="errMsg">
                                    @Html.Raw(ViewBag.Result)
                                </div>

                            </div>

                            <div class="row form-actions">
                                <div class="rem-pass">
                                    @if (ViewBag.DisplayBackButton)
                                    {
                                      
                                         <div class="col-xs-12">
                                             <input class='btn btn-warning  pull-right' id='btnBack' type='button' onclick="window.location = '/Security/ForgetPasswoed';" value='رجوع' />
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                   }
                </div>

                </div>
            </div></div>
                <!-- /login wrapper -->
                <!-- Footer -->
                <div class="footer clearfix">
                    <div class="pull-left">
                        جميع الحقوق محفوظة ©
                        برنامج إدارة المهام 2017
                        -
                        تم التطوير بواسطة <a target="_blank" href="http://qvsite.com">Q-Vision</a>
 
                    </div>
                    <div class="pull-right icons-group">
                        <a href="#"><i class="icon-screen2"></i></a>
                        <a href="#"><i class="icon-balance"></i></a>
                        <a href="#"><i class="icon-cog3"></i></a>
                    </div>
                </div>
                <!-- /footer -->

                <script src="~/Content/Site/js/bootstrap.js"></script>

</body>
</html>














